# Have Caddy serve prometheus metrics
http://caddy:2020 {
	metrics
}

# For old URLs, or domains you don't want people to use (such as "www")
# set the env variable DOMAIN_REDIRECTS. This snippet won't work unless
# a domain is given so even if you don't want to redirect, you need to
# set the env variable.
(redirect) {
	redir {$PROTOCOL}://{args[0]}{uri} permanent
}

# Caddy is the source of request IDs for API requests.
(reverse_proxy_common) {
	header_up X-Request-ID {http.request.uuid}
}

# Used for SPA clients accessible to all users
(spa) {
	encode gzip
	root * /srv{args[0]}
	@assets path /assets/*
	header @assets >Cache-Control "public, max-age=31536000, immutable"
	file_server {
		pass_thru
	}
	@non-file expression path_regexp('^[^.]*$')
	handle @non-file {
		header >Cache-Control "no-cache, no-store, must-revalidate"
		try_files {args[1]}
	}
}

# Used for SPA clients accessible to all users
(static-site) {
	encode gzip
	root * /srv{args[0]}
	file_server {
		pass_thru
	}
}

# Shared edge headers for HTML sites (marketing + SPAs). Not for api.* / kratos.* .
# > prefix: defer until response is written (needed after file_server / try_files).
# HSTS: @https when TLS terminates at Caddy; @https_cf when a proxy sends X-Forwarded-Proto.
(html-edge-headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "unsafe-none"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
	@https tls
	@https_cf header X-Forwarded-Proto https
	header @https >Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header @https_cf >Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# SPAs: style-src needs 'unsafe-inline' for Vue/Vuetify runtime-injected styles.
# CSP_CONNECT_SRC / CSP_SCRIPT_SRC_EXTRA / CSP_REPORT_URI from env (see env.caddy.prod-local).
(security-headers-spa) {
	import html-edge-headers
	header >Content-Security-Policy "default-src 'self'; script-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://static.cloudflareinsights.com {$CSP_SCRIPT_SRC_EXTRA}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' {$CSP_CONNECT_SRC}; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; frame-src 'self' blob:; worker-src 'self' blob:; report-uri {$CSP_REPORT_URI}"
}

# Marketing root static HTML.
(security-headers-marketing) {
	import html-edge-headers
	header >Content-Security-Policy "default-src 'self'; script-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self' {$CSP_CONNECT_SRC}; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; frame-src 'self' blob:; worker-src 'self' blob:"
}

# Backward-compatible alias.
(security-headers) {
	import security-headers-spa
}

# api.* / kratos.* — JSON APIs (no HTML CSP).
(transport-security) {
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}
	@https tls
	@https_cf header X-Forwarded-Proto https
	header @https >Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header @https_cf >Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# CORS: add response headers and handle OPTIONS preflight in Caddy so the backend never sees OPTIONS.
# args[0]: RE2 pattern matching allowed Origin header values (full origins).
# Set DOMAIN in env; import as: import cors {$DOMAIN}.
(cors) {
	@cors_origin_ok header_regexp Origin {args[0]}
	@options method OPTIONS
	handle @options {
		handle @cors_origin_ok {
			header {
				Vary Origin
				Cross-Origin-Resource-Policy "cross-origin"
				Access-Control-Allow-Origin "{http.request.header.Origin}"
				Access-Control-Allow-Credentials "true"
				Access-Control-Expose-Headers "Authorization"
				Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
				Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-Token, X-Requested-With, Accept, Last-Event-ID"
				Access-Control-Max-Age "600"
			}
			respond 204
		}
		respond 204
	}
	header {
		Vary Origin
		Cross-Origin-Resource-Policy "cross-origin"
		Access-Control-Allow-Credentials "true"
		Access-Control-Expose-Headers "Authorization"
	}
	header @cors_origin_ok Access-Control-Allow-Origin "{http.request.header.Origin}"
}

# Recipes API (and similar): probe Kratos /sessions/whoami; copy identity on 2xx, but never short-circuit the client on 401.
# args[0]: target service host (e.g. monolith:3002)
(kratos-api-proxy) {
	handle /health {
		reverse_proxy {args[0]} {
			import reverse_proxy_common
		}
	}

	handle {
		reverse_proxy kratos:4433 {
			method GET
			rewrite /sessions/whoami
			header_up X-Request-ID {http.request.uuid}
			header_up X-Forwarded-Method {http.request.method}
			header_up X-Forwarded-Uri {http.request.uri}

			@kratos_session_ok status 2xx
			handle_response @kratos_session_ok {
				request_header X-Kratos-Authenticated-Identity-Id {rp.header.X-Kratos-Authenticated-Identity-Id}
			}

			@kratos_session_unauthorized status 401
			handle_response @kratos_session_unauthorized {
			}
		}
		reverse_proxy {args[0]} {
			import reverse_proxy_common
		}
	}
}
