__PRODUCT_NAME___DOMAIN_REDIRECTS=https://www.__domain-name__/
__PRODUCT_NAME___SERVICE_HTTP_HOST=__product-name__-monolith:3001
__PRODUCT_NAME___PROTOCOL=https
__PRODUCT_NAME___DOMAIN=__domain-name__

# Space-separated origins for CSP connect-src on HTML sites.
CSP_CONNECT_SRC="https://api.__domain-name__ https://kratos.__domain-name__ https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io"

# Kratos public origin for Ory webauthn.js (passkeys).
CSP_SCRIPT_SRC_EXTRA=https://kratos.__domain-name__
# Browser CSP violation reports.
CSP_REPORT_URI=https://api.__domain-name__/csp-violations

# RE2: allowed browser Origins for Caddy CORS.
DOMAIN=^https://(app|auth|admin|account)\.__domain-name__$$|^https://__domain-name__$$
