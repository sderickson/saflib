# BEGIN WORKFLOW AREA caddy FOR product/init
__PRODUCT_NAME___DOMAIN=docker.localhost
__PRODUCT_NAME___DOMAIN_REDIRECTS=http://dne.docker.localhost
__PRODUCT_NAME___PROTOCOL=http
__PRODUCT_NAME___SERVICE_HTTP_HOST=__product-name__-monolith:3001

# Space-separated origins for CSP connect-src (browser fetch → api / kratos).
CSP_CONNECT_SRC="http://api.docker.localhost http://kratos.docker.localhost https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io"

# Kratos public origin for Ory webauthn.js (passkeys).
CSP_SCRIPT_SRC_EXTRA=http://kratos.docker.localhost
# Browser CSP violation reports (POST to product API; see POST /csp-violations).
CSP_REPORT_URI=http://api.docker.localhost/csp-violations

# RE2: allowed browser Origins for Caddy CORS (explicit subdomains; evil.localhost is not in this list).
# Compose env_file: use `$$` for a literal `$` (regex end anchor).
DOMAIN=^http://(app|auth|admin|account)\.docker\.localhost$$|^http://docker\.localhost$$

# END WORKFLOW AREA
