  "devDependencies": {
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*",
    "@types/express": "^5.0.0",
    "@types/http-errors": "^2.0.0",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0"
