{
  "openapi": "3.1.0",
  "info": {
    "title": "Identity Admin API",
    "version": "1.0.0",
    "description": "Site-admin views of Kratos identities, so admin pages can show people by name and email while logs and audit rows keep storing only ids.\n"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ory_kratos_session",
        "description": "Signed-in SAF user (Kratos browser session; internal job calls present the same identity via a signed assertion, which is not modeled here). Scopes: `email-verified`, `mfa`, `site-admin` (implies email-verified + mfa).\n"
      }
    },
    "schemas": {
      "IdentitySummary": {
        "$ref": "#/components/schemas/identity-summary"
      },
      "IdentityRecord": {
        "$ref": "#/components/schemas/identity-record"
      },
      "Error": {
        "$ref": "#/components/schemas/error"
      },
      "identity-summary": {
        "type": "object",
        "description": "What admin pages need to show a person. Resolved at read time; never stored.",
        "required": [
          "id",
          "email",
          "name",
          "verified",
          "state",
          "created_at",
          "org",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Kratos identity id."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The identity's email trait."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name, when the product supplies one."
          },
          "verified": {
            "type": "boolean",
            "description": "Whether any verifiable address is verified."
          },
          "state": {
            "type": "string",
            "description": "Kratos identity state (`active` or `inactive`)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "org": {
            "type": [
              "string",
              "null"
            ],
            "description": "The org(s) the person belongs to, when the product has orgs."
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Their role in that org, when the product has roles."
          },
          "admin": {
            "type": "boolean",
            "description": "A site admin: the email is in ADMIN_EMAILS and verified (the same rule the server's auth uses). Admin lists put admins first.\n"
          }
        }
      },
      "identity-record": {
        "description": "An identity as the Users page lists it.",
        "allOf": [
          {
            "$ref": "#/components/schemas/identity-summary"
          },
          {
            "type": "object",
            "required": [
              "mfa",
              "last_sign_in_at"
            ],
            "properties": {
              "mfa": {
                "type": "boolean",
                "description": "Whether a second factor (TOTP, security key or passkey) is set up."
              },
              "last_sign_in_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "When they last signed in, from their Kratos sessions."
              }
            }
          }
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  },
  "paths": {
    "/admin/identities": {
      "get": {
        "summary": "List and search identities",
        "description": "Everyone with an identity, newest first, optionally filtered by a search on name, email or id. Site admins only.\n",
        "operationId": "listIdentitiesAdmin",
        "security": [
          {
            "session": [
              "site-admin"
            ]
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Matches name or email (substring) or id (prefix), case-insensitive.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from a previous page's `next_cursor`.",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of identities.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "identities",
                    "next_cursor",
                    "total"
                  ],
                  "properties": {
                    "identities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/identity-record"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "total": {
                      "type": "integer",
                      "description": "How many identities match the search."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Site admin required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "502": {
            "description": "The identity service could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/identities/{id}": {
      "get": {
        "summary": "Get one identity",
        "description": "One identity with its second factors and active session count. Site admins only.",
        "operationId": "getIdentityAdmin",
        "security": [
          {
            "session": [
              "site-admin"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The identity.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "identity",
                    "mfa_methods",
                    "active_sessions"
                  ],
                  "properties": {
                    "identity": {
                      "$ref": "#/components/schemas/identity-record"
                    },
                    "mfa_methods": {
                      "type": "array",
                      "description": "Second factors set up, e.g. `totp`, `webauthn`, `passkey`.",
                      "items": {
                        "type": "string"
                      }
                    },
                    "active_sessions": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Site admin required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "No such identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "502": {
            "description": "The identity service could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/identities/lookup": {
      "post": {
        "summary": "Look up identities by id",
        "description": "Resolves a batch of identity ids to names and emails for display. Ids with no identity are left out of the result. Site admins only.\n",
        "operationId": "lookupIdentitiesAdmin",
        "security": [
          {
            "session": [
              "site-admin"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The identities that exist, in no particular order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "identities"
                  ],
                  "properties": {
                    "identities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/identity-summary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Site admin required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "502": {
            "description": "The identity service could not be reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  }
}
