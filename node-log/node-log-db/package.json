{
  "name": "@saflib/node-log-db",
  "saf": {
    "kind": "lib"
  },
  "description": "Persistent, redacted, searchable log store (SQLite + FTS5) with a batched Winston transport and retention",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./instances": "./instances.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate && saf-drizzle check-migrations",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/drizzle": "*",
    "@saflib/env": "*",
    "@saflib/utils": "*",
    "drizzle-orm": "^0.45.2",
    "logform": "^2.7.0",
    "prom-client": "^15.1.3",
    "winston-transport": "^4.0.0"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "drizzle-kit": "*",
    "winston": "^3.11.0"
  },
  "sideEffects": false
}
