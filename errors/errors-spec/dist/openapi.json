{
  "openapi": "3.1.0",
  "info": {
    "title": "Error Reporting API",
    "version": "1.0.0",
    "description": "Unified error capture (client, server, CSP) and admin viewing via an in-memory ring buffer."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ory_kratos_session",
        "description": "Signed-in SAF user (Kratos browser session; internal job calls present the same identity via a signed assertion, which is not modeled here). Scopes: `email-verified`, `mfa`, `site-admin` (implies email-verified + mfa).\n"
      }
    },
    "schemas": {
      "ReportedError": {
        "$ref": "#/components/schemas/reported-error"
      },
      "Error": {
        "$ref": "#/components/schemas/error"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      },
      "reported-error": {
        "type": "object",
        "description": "A reported error stored in the in-memory ring buffer.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Monotonic id for pagination."
          },
          "kind": {
            "type": "string",
            "enum": [
              "csp-violation",
              "client",
              "server",
              "test"
            ],
            "description": "Error category (CSP ingest, browser client, server exception, admin smoke test)."
          },
          "message": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Scrubbed context (Sentry extras, CSP report, client info, etc.)."
          },
          "source": {
            "type": "string",
            "description": "Originating surface (SPA name, subsystem, browser, etc.)."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "message",
          "metadata",
          "source",
          "timestamp"
        ]
      }
    }
  },
  "paths": {
    "/errors/record": {
      "post": {
        "summary": "Record a client-reported error",
        "operationId": "recordReportedError",
        "x-public": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reported_error": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "client"
                        ]
                      },
                      "message": {
                        "type": "string"
                      },
                      "stack": {
                        "type": "string"
                      },
                      "metadata": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "source": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "message"
                    ]
                  }
                },
                "required": [
                  "reported_error"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Error recorded in the server ring buffer."
          },
          "400": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/csp-violations": {
      "post": {
        "summary": "Ingest a Content-Security-Policy violation report",
        "description": "Accepts a browser CSP violation payload (`application/csp-report` or JSON with a `csp-report` object), normalizes into the shared error ring buffer as `kind: csp-violation`, and returns **204**. Tagged `csrf-exempt` because the browser cannot send our double-submit CSRF header on automatic violation posts. Tagged `no-auth` because browsers cannot rely on session cookies on automatic `report-uri` posts (no-cors).\n",
        "operationId": "postCspViolationReport",
        "x-public": true,
        "tags": [
          "csrf-exempt"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/csp-report": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "W3C CSP reporting body; typically includes a top-level `csp-report` object."
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "Some user agents send the same JSON as `application/json`."
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Report accepted and stored in the error ring buffer."
          },
          "400": {
            "description": "Malformed body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/test-error": {
      "post": {
        "summary": "Admin-only intentional server error",
        "description": "Throws an error on the server for verifying error reporting (e.g. Sentry and the admin Errors page). Requires an authenticated site admin.\n",
        "operationId": "postAdminTestError",
        "security": [
          {
            "session": [
              "site-admin"
            ]
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized — missing or invalid auth.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Admin privileges required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Intentional error for monitoring verification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/errors": {
      "get": {
        "summary": "List buffered reported errors",
        "description": "Development ring-buffer listing (`createDevErrorsRouter` only). Tagged `no-auth` so local dev stacks can read captured errors without a session, matching `/dev/logs`.\n",
        "operationId": "listReportedErrors",
        "x-public": true,
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "csp-violation",
                "client",
                "server",
                "test"
              ]
            },
            "description": "Filter by error kind."
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by source (substring match)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Maximum number of entries to return (from the tail)."
          }
        ],
        "responses": {
          "200": {
            "description": "Buffered reported errors, newest last within the filtered slice.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reported_errors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/reported-error"
                      }
                    }
                  },
                  "required": [
                    "reported_errors"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid auth.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — site admin required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/maintenance/raise-test-error": {
      "post": {
        "summary": "Intentional error for end-to-end jobs chain probe",
        "operationId": "raiseTestErrorMaintenance",
        "security": [
          {
            "session": [
              "site-admin"
            ]
          }
        ],
        "tags": [
          "background"
        ],
        "description": "Background maintenance probe: always returns HTTP 500 with `X-Jobs-Retry: never` so the job goes `dead` immediately (no retry storm) and is visible in the jobs admin UI. Invoked by the `testCronError` cron schedule (disabled outside deliberate verification) and manually by site admins. Empty body — no client fields.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "description": "Empty JSON object. No client fields; the response is unconditional.\n",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - caller is not a site admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Intentional failure for chain verification. Always includes `X-Jobs-Retry: never` so the queue marks the job `dead` without retries.\n",
            "headers": {
              "X-Jobs-Retry": {
                "required": true,
                "description": "Jobs runtime override. Always `never` for this operation — terminal even though the status is 5xx.\n",
                "schema": {
                  "type": "string",
                  "enum": [
                    "never"
                  ],
                  "example": "never"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  }
}
