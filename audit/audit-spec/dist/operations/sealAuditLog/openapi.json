{
  "openapi": "3.1.0",
  "info": {
    "title": "sealAuditLog",
    "version": "1.0.0"
  },
  "paths": {
    "/audit-logs/seal": {
      "post": {
        "summary": "Seal the active audit database (admin)",
        "description": "Snapshot the active DB, verify the hash chain, compress locally, then invoke the product's ship callback (upload + off-system seal report). Clears the active store only after ship succeeds. Requires an authenticated site admin.\n",
        "operationId": "sealAuditLog",
        "tags": [
          "site-admin-only"
        ],
        "responses": {
          "200": {
            "description": "Seal completed; `audit_seal_result.status` is `sealed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seal-audit-log-response"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — admin required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "409": {
            "description": "Skipped — empty active DB or concurrent seal (`audit_seal_result.status: skipped`).\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seal-audit-log-response"
                }
              }
            }
          },
          "500": {
            "description": "Seal pipeline failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/audit-seal-http-500"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "seal-audit-log-response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit_seal_result"
        ],
        "properties": {
          "audit_seal_result": {
            "$ref": "#/components/schemas/audit-seal-result"
          }
        }
      },
      "audit-seal-result": {
        "type": "object",
        "description": "Outcome of one audit seal pipeline run. On `sealed`, `archive` carries the sealed time range plus chain/upload metadata. On `skipped`, only `status`, `reason`, and `duration_ms` are present.\n",
        "additionalProperties": false,
        "required": [
          "status",
          "duration_ms"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "sealed",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "empty",
              "in_progress"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "size_bytes",
              "sha256_hex",
              "archive_key",
              "row_count",
              "head_hash",
              "tail_hash",
              "first_ts",
              "last_ts"
            ],
            "properties": {
              "filename": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256_hex": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "archive_key": {
                "type": "string",
                "description": "Remote archive identifier (object path, bucket key, etc.)."
              },
              "row_count": {
                "type": "integer",
                "minimum": 1
              },
              "head_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "tail_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "first_ts": {
                "type": "string",
                "format": "date-time"
              },
              "last_ts": {
                "type": "string",
                "format": "date-time"
              },
              "branch_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      },
      "audit-seal-http-500": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "audit_chain_corrupt",
                  "audit_ship_failed",
                  "audit_email_failed",
                  "audit_upload_failed",
                  "audit_unknown"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}