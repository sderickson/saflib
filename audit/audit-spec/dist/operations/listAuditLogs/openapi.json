{
  "openapi": "3.1.0",
  "info": {
    "title": "listAuditLogs",
    "version": "1.0.0"
  },
  "paths": {
    "/audit-logs": {
      "get": {
        "summary": "List audit log events (admin)",
        "description": "Paginated keyset scan of the audit database, ordered by timestamp then id. `head_at` / `tail_at` describe the earliest and latest timestamps currently stored. Requires an authenticated site admin.\n",
        "operationId": "listAuditLogs",
        "tags": [
          "site-admin-only"
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Only return events with `ts` greater than or equal to this instant (ISO-8601).\n",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque pagination cursor from a previous response's `next_cursor`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size (default 100, max 1000).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Sort by `ts` then `id`. `desc` returns newest events first (admin UI default).",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit events for this page plus table timestamp span.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "audit_logs",
                    "head_at",
                    "tail_at",
                    "next_cursor"
                  ],
                  "properties": {
                    "audit_logs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/audit-log"
                      }
                    },
                    "head_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "Earliest `ts` in the audit table, if any rows exist."
                    },
                    "tail_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "Latest `ts` in the audit table, if any rows exist."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` to fetch the next page, if more rows exist."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid `from`, `cursor`, or `order`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - admin privileges required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "audit-log": {
        "type": "object",
        "description": "One row from the append-only audit log (admin API shape).",
        "required": [
          "id",
          "ts",
          "prev_hash",
          "row_hash",
          "schema_version",
          "source",
          "event_type",
          "outcome",
          "git_commit_root",
          "git_commit_saflib",
          "env"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "prev_hash": {
            "type": "string"
          },
          "row_hash": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "http",
              "cron",
              "kratos",
              "system",
              "webhook"
            ]
          },
          "actor_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "on_behalf_of_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "auth_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_type": {
            "type": "string"
          },
          "resource_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "git_commit_root": {
            "type": "string"
          },
          "git_commit_saflib": {
            "type": "string"
          },
          "env": {
            "type": "string"
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Event-specific JSON payload; shape depends on `source`.",
            "additionalProperties": true
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}