{
  "openapi": "3.1.0",
  "info": {
    "title": "Audit Log API",
    "version": "1.0.0",
    "description": "Hash-chained append-only audit log — admin browse and chain verification."
  },
  "components": {
    "schemas": {
      "AuditLog": {
        "$ref": "#/components/schemas/audit-log"
      },
      "Error": {
        "$ref": "#/components/schemas/error"
      },
      "audit-log": {
        "type": "object",
        "description": "One row from the append-only audit log (admin API shape).",
        "required": [
          "id",
          "ts",
          "prev_hash",
          "row_hash",
          "schema_version",
          "source",
          "event_type",
          "outcome",
          "git_commit_root",
          "git_commit_saflib",
          "env"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "prev_hash": {
            "type": "string"
          },
          "row_hash": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "http",
              "cron",
              "kratos",
              "system",
              "webhook"
            ]
          },
          "actor_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "on_behalf_of_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "auth_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_type": {
            "type": "string"
          },
          "resource_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "git_commit_root": {
            "type": "string"
          },
          "git_commit_saflib": {
            "type": "string"
          },
          "env": {
            "type": "string"
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Event-specific JSON payload; shape depends on `source`.",
            "additionalProperties": true
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      },
      "audit-seal-result": {
        "type": "object",
        "description": "Outcome of one audit seal pipeline run. On `sealed`, `archive` carries the sealed time range plus chain/upload metadata. On `skipped`, only `status`, `reason`, and `duration_ms` are present.\n",
        "additionalProperties": false,
        "required": [
          "status",
          "duration_ms"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "sealed",
              "skipped"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "empty",
              "in_progress"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "size_bytes",
              "sha256_hex",
              "archive_key",
              "row_count",
              "head_hash",
              "tail_hash",
              "first_ts",
              "last_ts"
            ],
            "properties": {
              "filename": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256_hex": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "archive_key": {
                "type": "string",
                "description": "Remote archive identifier (object path, bucket key, etc.)."
              },
              "row_count": {
                "type": "integer",
                "minimum": 1
              },
              "head_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "tail_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "first_ts": {
                "type": "string",
                "format": "date-time"
              },
              "last_ts": {
                "type": "string",
                "format": "date-time"
              },
              "branch_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "seal-audit-log-response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit_seal_result"
        ],
        "properties": {
          "audit_seal_result": {
            "$ref": "#/components/schemas/audit-seal-result"
          }
        }
      },
      "audit-seal-http-500": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "audit_chain_corrupt",
                  "audit_ship_failed",
                  "audit_email_failed",
                  "audit_upload_failed",
                  "audit_unknown"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/audit-logs": {
      "get": {
        "summary": "List audit log events (admin)",
        "description": "Paginated keyset scan of the audit database, ordered by timestamp then id. `head_at` / `tail_at` describe the earliest and latest timestamps currently stored. Requires an authenticated site admin.\n",
        "operationId": "listAuditLogs",
        "tags": [
          "site-admin-only"
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Only return events with `ts` greater than or equal to this instant (ISO-8601).\n",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque pagination cursor from a previous response's `next_cursor`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size (default 100, max 1000).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Sort by `ts` then `id`. `desc` returns newest events first (admin UI default).",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit events for this page plus table timestamp span.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "audit_logs",
                    "head_at",
                    "tail_at",
                    "next_cursor"
                  ],
                  "properties": {
                    "audit_logs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/audit-log"
                      }
                    },
                    "head_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "Earliest `ts` in the audit table, if any rows exist."
                    },
                    "tail_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "Latest `ts` in the audit table, if any rows exist."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` to fetch the next page, if more rows exist."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid `from`, `cursor`, or `order`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - admin privileges required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/audit-logs/seal": {
      "post": {
        "summary": "Seal the active audit database (admin)",
        "description": "Snapshot the active DB, verify the hash chain, compress locally, then invoke the product's ship callback (upload + off-system seal report). Clears the active store only after ship succeeds. Requires an authenticated site admin.\n",
        "operationId": "sealAuditLog",
        "tags": [
          "site-admin-only"
        ],
        "responses": {
          "200": {
            "description": "Seal completed; `audit_seal_result.status` is `sealed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seal-audit-log-response"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — admin required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "409": {
            "description": "Skipped — empty active DB or concurrent seal (`audit_seal_result.status: skipped`).\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/seal-audit-log-response"
                }
              }
            }
          },
          "500": {
            "description": "Seal pipeline failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/audit-seal-http-500"
                }
              }
            }
          }
        }
      }
    }
  }
}
