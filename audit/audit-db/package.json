{
  "name": "@saflib/audit-db",
  "description": "Append-only hash-chained audit database for SAF products.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./instances": "./instances.ts",
    "./queries/*": "./queries/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/drizzle": "*",
    "@saflib/env": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@types/proper-lockfile": "^4.1.4",
    "drizzle-kit": "*"
  },
  "sideEffects": false
}
