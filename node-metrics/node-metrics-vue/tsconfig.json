{
  "extends": ["../../vue/tsconfig.app.base.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["vite/client"]
  },
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "references": [
    { "path": "../../sdk" },
    { "path": "../../vue" },
    { "path": "../node-metrics-spec" },
    { "path": "../node-metrics-sdk" }
  ],
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "**/*.json"]
}
