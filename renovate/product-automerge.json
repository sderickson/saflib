{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Opt-in for SAF product repos: Renovate merges low-risk updates itself once CI is green (Actions and image digests/patches, npm patches of product-only packages). Majors and minors still wait for a person.",
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
