{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate defaults for SAF product repos. Generated by `saf-monorepo renovate-preset` from saflib's package.json files; don't edit by hand.",
  "timezone": "America/Los_Angeles",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null
  },
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "Docker images",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "description": "saflib owns these versions. Products get them by bumping saflib (saf-monorepo saflib-bump), which copies saflib's overrides and re-resolves the lockfile.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@azure/identity",
        "@azure/storage-blob",
        "@google-cloud/storage",
        "@grpc/grpc-js",
        "@infisical/sdk",
        "@mdi/js",
        "@ory/client",
        "@playwright/test",
        "@resvg/resvg-js",
        "@sentry/node",
        "@sentry/vite-plugin",
        "@sentry/vue",
        "@tanstack/vue-query",
        "@testing-library/vue",
        "@types/better-sqlite3",
        "@types/cors",
        "@types/express",
        "@types/google-protobuf",
        "@types/http-errors",
        "@types/jsdom",
        "@types/json-schema",
        "@types/morgan",
        "@types/multer",
        "@types/node",
        "@types/proper-lockfile",
        "@types/supertest",
        "@vitejs/plugin-vue",
        "@vitest/coverage-v8",
        "@vue/compiler-core",
        "@vue/compiler-dom",
        "@vue/compiler-sfc",
        "@vue/compiler-ssr",
        "@vue/devtools-kit",
        "@vue/reactivity",
        "@vue/runtime-core",
        "@vue/runtime-dom",
        "@vue/server-renderer",
        "@vue/shared",
        "@vue/test-utils",
        "@vue/tsconfig",
        "ajv",
        "axios",
        "better-sqlite3",
        "commander",
        "cors",
        "cron",
        "dejavu-fonts-ttf",
        "dompurify",
        "drizzle-kit",
        "drizzle-orm",
        "editorconfig",
        "entities",
        "esbuild",
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue",
        "express",
        "express-openapi-validator",
        "express-prom-bundle",
        "globals",
        "google-protobuf",
        "helmet",
        "htmlparser2",
        "http-errors",
        "jsdom",
        "json-schema-to-typescript",
        "logform",
        "marked",
        "memfs",
        "minimatch",
        "morgan",
        "msw",
        "multer",
        "openapi-fetch",
        "openapi-types",
        "openapi-typescript",
        "path-to-regexp",
        "posthog-js",
        "posthog-node",
        "prettier",
        "prom-client",
        "proper-lockfile",
        "protoc-gen-ts",
        "rolldown",
        "rollup-plugin-ignore",
        "sass-embedded",
        "serve",
        "supertest",
        "tsup",
        "typedoc",
        "typedoc-plugin-markdown",
        "typedoc-plugin-vue",
        "typescript",
        "typescript-eslint",
        "undici",
        "vite",
        "vite-plugin-vue-devtools",
        "vite-plugin-vuetify",
        "vitepress",
        "vitest",
        "vue",
        "vue-component-meta",
        "vue-i18n",
        "vue-router",
        "vue-tsc",
        "vuetify",
        "winston",
        "winston-loki",
        "winston-transport",
        "xstate",
        "yaml"
      ],
      "enabled": false
    },
    {
      "description": "saflib's own packages come with the submodule.",
      "matchPackageNames": [
        "@saflib/{/,}**"
      ],
      "enabled": false
    },
    {
      "description": "Node follows saflib (its base images and CI); move a product's Node after saflib's.",
      "matchPackageNames": [
        "node"
      ],
      "matchDatasources": [
        "docker",
        "node-version"
      ],
      "enabled": false
    }
  ]
}
