{
  "name": "@saflib/parser",
  "saf": {
    "kind": "lib"
  },
  "description": "Syntactic TypeScript helpers — extractExports / extractTestCases / extractDrizzleTables (no type-checker)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "typescript": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
