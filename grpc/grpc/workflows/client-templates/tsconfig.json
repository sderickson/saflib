{
  "extends": "@saflib/monorepo/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "references": [
    {
      "path": "../.."
    },
    {
      "path": "../../../../env"
    },
    {
      "path": "../../../../monorepo"
    },
    {
      "path": "../proto-templates"
    }
  ]
}
