# @saflib/env
ALLOW_DB_CREATION=true
DEPLOYMENT_NAME=development
NODE_ENV=development
PROTOCOL=http
TZ=UTC

# base-specific @saflib/env
TRADEMARK=Base
DOMAIN=docker.localhost
CLIENT_SUBDOMAINS=,auth,app,admin,account
SERVICE_SUBDOMAINS=base

KRATOS_HANDLER_HTTP_HOST=base-monolith:3000
SENTRY_DSN=mock

# @saflib/email
NODEMAILER_TRANSPORT_CONFIG=

# @saflib/base-http
BASE_SERVICE_HTTP_HOST=base-monolith:3001

ADMIN_EMAILS=admin@saflib.com