# @saflib/env
ALLOW_DB_CREATION=true
DEPLOYMENT_NAME=development
NODE_ENV=development
PROTOCOL=http
TZ=UTC

# base-specific @saflib/env
TRADEMARK=Base
DOMAIN=docker.localhost
# Template stub SPA subdomain is for base/dev only; product/init strips it.
# vue/add-spa appends new subdomains to this line.
CLIENT_SUBDOMAINS=,auth,app,admin,account,__subdomain-name__
SERVICE_SUBDOMAINS=api

KRATOS_HANDLER_HTTP_HOST=base-monolith:3000
SENTRY_DSN=mock

# @saflib/email
NODEMAILER_TRANSPORT_CONFIG=

# @saflib/base-http
BASE_SERVICE_HTTP_HOST=base-monolith:3001
BASE_SERVICE_INTERNAL_SOCKET=/tmp/base-internal.sock
BASE_SERVICE_JOBS_SOCKET=/tmp/base-jobs-internal.sock
SAF_JOBS_SOCKET=/tmp/base-jobs-internal.sock

ADMIN_EMAILS=admin@saflib.com
# Client nav chrome (mirrors ADMIN_EMAILS; Vite only exposes VITE_* to the browser)
VITE_ADMIN_EMAILS=admin@saflib.com
