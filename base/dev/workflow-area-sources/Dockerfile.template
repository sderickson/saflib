# Source for CopyStep upsert into {product}/dev/Dockerfile.template.
# Live Dockerfile.template keeps these areas empty so base/dev caddy builds
# without the expansion stub image.
# BEGIN WORKFLOW AREA static-site-builders FOR vue/add-static-site
FROM saflib-base-__static-subdomain-name__-static:latest AS __static-subdomain-name__-static-builder
RUN npm run build
# END WORKFLOW AREA

# BEGIN WORKFLOW AREA static-site-assets FOR vue/add-static-site
COPY --from=__static-subdomain-name__-static-builder /app/base/clients/__static-subdomain-name__/.vitepress/dist /srv/base-static-__static-subdomain-name__
# END WORKFLOW AREA
