{
  "name": "@saflib/base-dev",
  "description": "Docker compose setup for dev environment",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "build": "saf-docker build --compose docker-compose.yaml",
    "dev": "saf-docker build --compose docker-compose.yaml && ./scripts/sync-node-modules.sh && ./scripts/dev-compose.sh up -V",
    "up": "saf-docker build --compose docker-compose.yaml && ./scripts/sync-node-modules.sh && ./scripts/dev-compose.sh up --detach -V",
    "prune": "saf-docker prune",
    "down": "saf-docker generate && docker compose --env-file env.dev --env-file .env -f docker-compose.yaml down",
    "dev-site": "saf-docker build @saflib/dev-site-docker && ./scripts/dev-site-compose.sh up -V",
    "dev-site:down": "./scripts/dev-site-compose.sh down"
  },
  "dependencies": {
    "@saflib/dev-site-docker": "*",
    "@saflib/docker": "*"
  },
  "sideEffects": false
}
