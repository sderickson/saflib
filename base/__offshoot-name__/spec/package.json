{
  "name": "@saflib/base-__offshoot-name__-spec",
  "saf": {
    "kind": "spec"
  },
  "description": "Offshoot OpenAPI for Base __offshoot-name__; served by its own http package",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./json-spec": "./dist/json-spec.ts",
    "./openapi.yaml": "./openapi.yaml",
    "./package.json": "./package.json",
    "./operations/*": "./dist/operations/*/index.ts",
    "./schemas/*": "./dist/schemas/*/index.ts"
  },
  "scripts": {
    "build": "saf-specs generate -f openapi.yaml -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "generate": "npm exec saf-specs generate"
  },
  "dependencies": {
    "@saflib/openapi": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
