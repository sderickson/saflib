# Fills in {$...} in kratos.Caddyfile. DOMAIN is the identity domain: Kratos
# shares sign-in sessions across it and its subdomains.
DOMAIN=__domain-name__
PROTOCOL=https
# Any site on the identity domain, including satellites' (app.<name>.<domain>).
CORS_ORIGINS=^https://([a-z0-9-]+\.)*__escaped-domain-name__$
