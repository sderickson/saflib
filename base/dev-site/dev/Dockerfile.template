# syntax=docker/dockerfile:labs
# Live-dev image: npm ci once; compose bind-mounts source over packages.
# Generated by `saf-docker generate` from workspace deps of @saflib/base-dev-site-dev.
FROM node:24-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g npm@11.14.1

WORKDIR /app

#{ copy_packages }#
RUN npm ci

