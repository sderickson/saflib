{
  "name": "@saflib/base-dev-site-http",
  "description": "Runnable HTTP service for the base product's dev-site instance",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types run.ts",
    "dev": "nodemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/base-jobs": "*",
    "@saflib/dev-site-db": "*",
    "@saflib/dev-site-http": "*",
    "@saflib/env": "*",
    "@saflib/express": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false,
  "imports": {
    "#env.ts": "./env.ts"
  }
}
