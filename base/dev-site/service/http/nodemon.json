{
  "watch": [
    ".",
    "../../../../dev-site/dev-site-http",
    "../../../../dev-site/dev-site-db",
    "../../../../dev-site/dev-site-spec",
    "../../../../git",
    "../../../../parser",
    "../../../../express",
    "../../../../node",
    "../../../../drizzle",
    "../../../../monorepo",
    "../../../../env",
    "../../../../openapi",
    "../../../service/jobs"
  ],
  "ext": "ts,js,mjs,cjs,json",
  "ignore": [
    "**/*.test.ts",
    "**/node_modules/**",
    "**/data/**",
    "**/dev-site-vue/**",
