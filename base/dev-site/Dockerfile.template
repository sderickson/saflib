# syntax=docker/dockerfile:labs
# Built site: Express API + SPA static assets on one port.
# Generated by `saf-docker generate` from workspace deps of @saflib/base-dev-site.
FROM node:24-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g npm@11.14.1

WORKDIR /app

#{ copy_packages }#
RUN npm ci

#{ copy_src }#

WORKDIR /app/base/dev-site/clients/app
RUN npm run build

ENV NODE_ENV=production \
  TZ=UTC \
  ALLOW_DB_CREATION=true \
  DEV_SITE_SERVICE_HTTP_HOST=0.0.0.0:3099 \
  DEV_SITE_PRODUCT_ROOT=base \
  DEV_SITE_MAIN_REF=main \
  DEV_SITE_STATIC_DIR=/app/base/dev-site/clients/app/dist \
  DEV_SITE_DB_PATH=/data/dev-site.sqlite

WORKDIR /app/base/dev-site/service/http
EXPOSE 3099
CMD ["npm", "start"]
