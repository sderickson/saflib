{
  "name": "@saflib/base-http",
  "saf": {
    "kind": "http"
  },
  "description": "HTTP server for the base service",
  "type": "module",
  "exports": {
    "./http": "./http.ts",
    "./testing/slim-route-test": "./testing/slim-route-test.ts",
    "./handlers/*": "./handlers/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/base-__offshoot-name__-http": "*",
    "@saflib/base-audit": "*",
    "@saflib/base-cron": "*",
    "@saflib/base-db": "*",
    "@saflib/base-jobs": "*",
    "@saflib/base-service-common": "*",
    "@saflib/base-spec": "*",
    "@saflib/cron": "*",
    "@saflib/express": "*",
    "@saflib/jobs": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "http-errors": "^2.0.0"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@types/http-errors": "^2.0.0",
    "supertest": "^7.0.0"
  },
  "sideEffects": false
}
