{
  "name": "@saflib/base-http",
  "saf": {
    "kind": "http"
  },
  "description": "HTTP server for the base service",
  "type": "module",
  "exports": {
    "./http": "./http.ts",
    "./routers": "./routers.ts",
    "./test/slim-route-test": "./test/slim-route-test.ts",
    "./handlers/*": "./handlers/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/analytics-http": "*",
    "@saflib/base-__offshoot-name__-http": "*",
    "@saflib/base-audit": "*",
    "@saflib/base-cron": "*",
    "@saflib/base-db": "*",
    "@saflib/base-jobs": "*",
    "@saflib/base-service-common": "*",
    "@saflib/base-spec": "*",
    "@saflib/cron-http": "*",
    "@saflib/email-service": "*",
    "@saflib/errors-http": "*",
    "@saflib/express": "*",
    "@saflib/vendors-brevo": "*",
    "@saflib/jobs-http": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "@saflib/node-log-http": "*",
    "@saflib/node-metrics-http": "*",
    "http-errors": "^2.0.0",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@types/http-errors": "^2.0.0",
    "supertest": "^7.0.0"
  },
  "sideEffects": false,
  "imports": {
    "#handlers/*": "./handlers/*",
    "#http.ts": "./http.ts",
    "#test/*": "./test/*"
  }
}
