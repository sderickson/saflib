{
  "name": "@saflib/base-db",
  "saf": {
    "kind": "db"
  },
  "description": "Database package for base.",
  "private": true,
  "type": "module",
  "exports": {
    "./instances": "./instances.ts",
    "./errors": "./errors.ts",
    "./types": "./types.ts",
    "./queries/*": "./queries/*.ts",
    "./schemas/*": "./schemas/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/base-__offshoot-name__-db": "*",
    "@saflib/drizzle": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false,
  "imports": {
    "#errors.ts": "./errors.ts",
    "#instances.ts": "./instances.ts",
    "#queries/*": "./queries/*",
    "#schemas/*": "./schemas/*",
    "#types.ts": "./types.ts"
  }
}
