{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../../../env"
    },
    {
      "path": "../../../errors/errors-http"
    },
    {
      "path": "../../../express"
    },
    {
      "path": "../../../jobs/jobs"
    },
    {
      "path": "../../../monorepo"
    },
    {
      "path": "../../../node"
    },
    {
      "path": "../../../vendors/loki"
    },
    {
      "path": "../../../vendors/sentry-node"
    },
    {
      "path": "../audit"
    },
    {
      "path": "../common"
    },
    {
      "path": "../cron"
    },
    {
      "path": "../db"
    },
    {
      "path": "../http"
    },
    {
      "path": "../jobs"
    },
    {
      "path": "../kratos-handlers"
    },
    {
      "path": "../spec"
    }
  ]
}
