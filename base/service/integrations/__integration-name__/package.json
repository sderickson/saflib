{
  "name": "@saflib/base-__integration-name__-integration",
  "saf": {
    "kind": "integration",
    "envExtends": [
      "@saflib/env"
    ]
  },
  "description": "Golden integration stub for Base (expansion via integrations/add-call)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./mocks": "./client.mocks.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "ping": "saf-ts-run ./bin/ping.ts"
  },
  "dependencies": {
    "@saflib/env": "*",
    "@saflib/secret-store": "*"
  },
  "devDependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*"
  },
  "sideEffects": false,
  "imports": {
    "#*": "./*"
  }
}
