{
  "openapi": "3.0.0",
  "info": {
    "title": "base API",
    "version": "1.0.0",
    "description": "API specification for the base service"
  },
  "paths": {
    "__url-path__": {
      "__method__": {
        "$ref": "/var/folders/30/trj7szrx71d4wp3391q244z00000gn/T/saf-specs-rFnYP1/routes/__group-name__/__target-name__.yaml#/__operationId__"
      }
    },
    "/jobs-demo/start": {
      "post": {
        "summary": "Start the jobs demo chain",
        "description": "Site-admin-only foreground endpoint that enqueues `jobsDemoStepB` with optional demo options (dedupe, concurrency, retry simulation payload).\n",
        "operationId": "startJobsDemo",
        "tags": [
          "site-admin-only",
          "jobs-demo"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/jobs-demo-options"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enqueued step-b job.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/jobs-demo-start-result"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - user does not have required privileges.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs-demo/step-b": {
      "post": {
        "summary": "Jobs demo chain step B",
        "description": "Background step that optionally fails N times (503) to demonstrate retries, then enqueues `jobsDemoStepC`.\n",
        "operationId": "jobsDemoStepB",
        "tags": [
          "site-admin-only",
          "background",
          "jobs-demo"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/jobs-demo-options"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enqueued step-c after optional simulated failures.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/jobs-demo-step-result"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - user does not have required privileges.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "503": {
            "description": "Simulated retryable failure (demo only).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs-demo/step-c": {
      "post": {
        "summary": "Jobs demo chain step C",
        "description": "Background terminal step that records demo chain completion.",
        "operationId": "jobsDemoStepC",
        "tags": [
          "site-admin-only",
          "background",
          "jobs-demo"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/jobs-demo-options"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo chain completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/jobs-demo-step-result"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - user does not have required privileges.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/__offshoot-name__/health": {
      "get": {
        "operationId": "get__OffshootName__Health",
        "summary": "Health check for the __offshoot-name__ offshoot",
        "responses": {
          "200": {
            "description": "Offshoot is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "$ref": "#/components/schemas/error"
      },
      "ProductEvent": {
        "$ref": "#/components/schemas/index"
      },
      "__TargetName__": {
        "$ref": "#/components/schemas/__target-name__"
      },
      "jobs-demo-options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dedupeKey": {
            "type": "string",
            "nullable": true,
            "description": "Optional dedupe key forwarded to the enqueued job."
          },
          "concurrencyKey": {
            "type": "string",
            "nullable": true,
            "description": "Optional concurrency key forwarded to the enqueued job."
          },
          "failuresBeforeSuccess": {
            "type": "integer",
            "minimum": 0,
            "description": "For step-b demos: respond 503 this many times before succeeding and enqueueing step-c.\n"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "Arbitrary JSON echoed through the demo chain."
          }
        }
      },
      "job": {
        "type": "object",
        "description": "Wire form of a queued API-call job. CamelCase projection of the `job` row; omits internal columns (`heartbeatAt`, `updatedAt`). Authority is the discriminated evidence grant without the raw enqueue assertion token (detail endpoints may return that separately as `authorityAssertion`).\n",
        "properties": {
          "id": {
            "type": "string",
            "description": "Short identifier for the job (from generateShortId).",
            "example": "Jb3k_mN7"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "retrying",
              "succeeded",
              "dead",
              "cancelled"
            ],
            "description": "Lifecycle state. `pending`/`retrying` are claimable; `running` is in delivery; `succeeded`/`dead`/`cancelled` are terminal.\n",
            "example": "pending"
          },
          "operationId": {
            "type": "string",
            "description": "Target OpenAPI operationId resolved at delivery time.",
            "example": "jobsDemoStepB"
          },
          "request": {
            "type": "object",
            "description": "Capped request payload delivered to the target operation (serialized size ≤ 16 KB). Path params, query, and body are optional and substituted into the operation's path template / request.\n",
            "additionalProperties": false,
            "properties": {
              "pathParams": {
                "type": "object",
                "description": "Path template substitutions keyed by parameter name.",
                "additionalProperties": true
              },
              "query": {
                "type": "object",
                "description": "Query string parameters keyed by name.",
                "additionalProperties": true
              },
              "body": {
                "description": "JSON request body for the target operation, when any."
              }
            },
            "example": {
              "body": {
                "failuresBeforeSuccess": 2
              }
            }
          },
          "userId": {
            "type": "string",
            "description": "Acting user whose authority the job runs under.",
            "example": "Us7k_pQ2"
          },
          "authority": {
            "description": "Root grant for the job chain (copied verbatim by children). Discriminated on `kind`. Wire form excludes the embedded enqueue assertion token.\n",
            "discriminator": {
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "type": "object",
                "description": "A user's authenticated request (or an admin action) instigated the chain. Evidence is the originating request id (also in the audit log).\n",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "userId",
                  "requestId"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "request"
                    ],
                    "example": "request"
                  },
                  "userId": {
                    "type": "string",
                    "description": "User who made the originating request.",
                    "example": "Us7k_pQ2"
                  },
                  "requestId": {
                    "type": "string",
                    "description": "Originating request id (e.g. X-Request-ID).",
                    "example": "r-abc123"
                  }
                }
              },
              {
                "type": "object",
                "description": "A webhook arrived for a channel subscription; the importer's creator authorized scanning this channel. Evidence is the importer row.\n",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "userId",
                  "importerId"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "importer"
                    ],
                    "example": "importer"
                  },
                  "userId": {
                    "type": "string",
                    "description": "Importer creator whose authority is used.",
                    "example": "Us7k_pQ2"
                  },
                  "importerId": {
                    "type": "string",
                    "description": "Short id of the importer row that authorized the chain.",
                    "example": "Im7k_mN2"
                  }
                }
              },
              {
                "type": "object",
                "description": "A cron tick fired for an enabled job; the admin who last enabled it is the recorded authority. Evidence is the cron job name.\n",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "userId",
                  "cronJobName"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "cron"
                    ],
                    "example": "cron"
                  },
                  "userId": {
                    "type": "string",
                    "description": "Admin who enabled the cron job (`enabled_by`).",
                    "example": "Us7k_pQ2"
                  },
                  "cronJobName": {
                    "type": "string",
                    "description": "Name of the cron job that enqueued this chain.",
                    "example": "recoverySweep"
                  }
                }
              }
            ]
          },
          "originalRequestId": {
            "type": "string",
            "description": "Chain-root request id (user request / webhook X-Request-ID, or cron-tick id). Copied from parent on chained enqueues; joins audit_event.request_id.\n",
            "example": "r-abc123"
          },
          "enqueuedByOperationId": {
            "type": "string",
            "description": "Calling operationId that enqueued this job (trigger-map edge).",
            "example": "startJobsDemo"
          },
          "parentJobId": {
            "type": "string",
            "nullable": true,
            "description": "Short id of the job that enqueued this one, or null at the chain root.",
            "example": null
          },
          "runAt": {
            "type": "string",
            "format": "date-time",
            "description": "Earliest time the job may be claimed for delivery.",
            "example": "2026-08-06T21:00:00.000Z"
          },
          "dedupeKey": {
            "type": "string",
            "nullable": true,
            "description": "Optional key unique among non-terminal jobs. Re-enqueue with the same live key upserts (pushes runAt, refreshes request) and returns the existing job.\n",
            "example": "matter:demo-1:claim"
          },
          "concurrencyKey": {
            "type": "string",
            "nullable": true,
            "description": "Optional key limiting concurrency: at most one running job per key (e.g. `matter:{id}`).\n",
            "example": "matter:demo-1"
          },
          "priority": {
            "type": "integer",
            "description": "Claim priority; higher values are claimed first. Default 0.",
            "example": 0
          },
          "attempt": {
            "type": "integer",
            "description": "Number of delivery attempts consumed so far (0 before first claim).",
            "example": 0
          },
          "maxAttempts": {
            "type": "integer",
            "description": "Maximum delivery attempts before the job becomes dead (exhausted).",
            "example": 5
          },
          "result": {
            "type": "object",
            "nullable": true,
            "description": "Outcome of the latest terminal or failed attempt. Null while the job has not yet finished an attempt that records a result. `errorBody` is set only on failure and capped at 8 KB.\n",
            "additionalProperties": false,
            "properties": {
              "statusCode": {
                "type": "integer",
                "description": "HTTP status code from the delivery attempt, when available.",
                "example": 500
              },
              "errorBody": {
                "type": "string",
                "nullable": true,
                "description": "Capped error response body recorded only on failure.",
                "example": "{\"error\":\"upstream timeout\"}"
              },
              "terminalReason": {
                "type": "string",
                "nullable": true,
                "enum": [
                  "exhausted",
                  "permanent-status",
                  "rejected-by-endpoint",
                  "auth-unresolvable",
                  "cancelled-by-admin",
                  "cancelled-by-chain",
                  null
                ],
                "description": "Why the job became terminal. Null when the job succeeded or result is from a non-terminal retryable failure mid-flight.\n",
                "example": "exhausted"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the job row was created.",
            "example": "2026-08-06T20:59:55.000Z"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the current (or last) delivery attempt started; null if never claimed.",
            "example": null
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When the job reached a terminal status; null while still active.",
            "example": null
          }
        },
        "required": [
          "id",
          "status",
          "operationId",
          "request",
          "userId",
          "authority",
          "originalRequestId",
          "enqueuedByOperationId",
          "parentJobId",
          "runAt",
          "dedupeKey",
          "concurrencyKey",
          "priority",
          "attempt",
          "maxAttempts",
          "result",
          "createdAt",
          "startedAt",
          "finishedAt"
        ]
      },
      "jobs-demo-start-result": {
        "type": "object",
        "required": [
          "job"
        ],
        "properties": {
          "job": {
            "$ref": "#/components/schemas/job"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      },
      "jobs-demo-step-result": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enqueued": {
                "type": "string",
                "description": "operationId enqueued by this step."
              },
              "done": {
                "type": "boolean",
                "description": "True when step-c recorded completion."
              }
            }
          }
        }
      },
      "health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "login": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "login"
            ]
          },
          "context": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "email"
                ]
              }
            }
          }
        },
        "required": [
          "event",
          "context"
        ]
      },
      "signup": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "signup"
            ]
          },
          "context": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "email"
                ]
              }
            }
          }
        }
      },
      "signup_view": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "signup_view"
            ]
          }
        }
      },
      "verify_email": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "verify_email"
            ]
          }
        }
      },
      "__target_name__": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "__target_name__"
            ]
          },
          "context": {
            "type": "object",
            "properties": null
          }
        },
        "required": [
          "event",
          "context"
        ]
      },
      "index": {
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/login"
          },
          {
            "$ref": "#/components/schemas/signup"
          },
          {
            "$ref": "#/components/schemas/signup_view"
          },
          {
            "$ref": "#/components/schemas/verify_email"
          },
          {
            "$ref": "#/components/schemas/__target_name__"
          }
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "description": "The frontend client that triggered the event. For web, it should be \"web-{spa-name}\"."
          },
          "view": {
            "type": "string",
            "description": "The page that triggered the event. For vue, it should be the route name provided by vue router."
          },
          "component": {
            "type": "string",
            "description": "The component that triggered the event. For vue, it should be the component name."
          }
        },
        "required": [
          "event"
        ]
      },
      "__target-name__": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the template-resource (short id, e.g. from generateShortId)",
            "example": "K3m9_xR2"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the template-resource",
            "example": "Example Template Resource"
          },
          "description": {
            "type": "string",
            "description": "Optional description of the template-resource",
            "example": "This is an example template resource"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the template-resource was created",
            "example": "2023-01-01T00:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the template-resource was last updated",
            "example": "2023-01-01T00:00:00Z"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  }
}
