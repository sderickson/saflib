{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "**/*.weave.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../../../audit/audit-db"
    },
    {
      "path": "../../../drizzle"
    },
    {
      "path": "../../../email/email-service"
    },
    {
      "path": "../../../monorepo"
    },
    {
      "path": "../../../node"
    },
    {
      "path": "../../../object-store"
    },
    {
      "path": "../../../vendors/brevo"
    },
    {
      "path": "../db"
    }
  ]
}
