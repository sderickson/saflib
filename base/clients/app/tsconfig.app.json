{
  "extends": [
    "../../../vue/tsconfig.app.base.json"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "node_modules",
    "e2e",
    "playwright.config.ts",
    "dist/types",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "references": [
    {
      "path": "../../../links"
    },
    {
      "path": "../../../ory-kratos-sdk"
    },
    {
      "path": "../../../ory-kratos-spa"
    },
    {
      "path": "../../../vue"
    },
    {
      "path": "../../service/sdk"
    },
    {
      "path": "../common"
    },
    {
      "path": "../links"
    }
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "**/*.json"
  ]
}
