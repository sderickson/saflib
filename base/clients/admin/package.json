    "test:e2e:ui": "npx playwright test --ui",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@saflib/analytics-vue": "*",
    "@saflib/audit-vue": "*",
    "@saflib/base-clients-common": "*",
    "@saflib/base-links": "*",
    "@saflib/base-sdk": "*",
    "@saflib/cron-vue": "*",
    "@saflib/email-vue": "*",
    "@saflib/errors-vue": "*",
    "@saflib/jobs-vue": "*",
    "@saflib/links": "*",
    "@saflib/node-log-vue": "*",
    "@saflib/node-metrics-vue": "*",
    "@saflib/ory-kratos-sdk": "*",
    "@saflib/ory-kratos-spa": "*",
    "@saflib/vue": "*",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@saflib/playwright": "*"
  },
  "sideEffects": false,
  "imports": {
    "#*": "./*"
  }
