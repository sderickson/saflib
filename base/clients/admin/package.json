{
  "name": "@saflib/base-admin-spa",
  "saf": {
    "kind": "spa"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./main.ts",
    "./strings": "./strings.ts",
    "./i18n": "./i18n.ts",
    "./test-app": "./test-app.ts",
    "./*": "./*"
  },
  "scripts": {
