{
  "name": "@saflib/base-clients-common",
  "description": "Shared look-and-feel and utilities for web clients",
  "private": true,
  "type": "module",
  "exports": {
    "./assets/*": "./assets/*.ts",
    "./clients": "./clients/index.ts",
    "./clients/*": "./clients/*.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*.ts",
    "./composables/*": "./composables/*.ts",
    "./fixtures": "./fixtures/index.ts",
    "./fixtures/*": "./fixtures/*.ts",
    "./utils/*": "./utils/*.ts",
    "./vuetify-config": "./vuetify-config.ts",
    "./strings": "./strings.ts",
    "./i18n": "./i18n.ts",
    "./playwright.config": "./playwright.config.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@saflib/analytics-vue": "*",
    "@saflib/base-links": "*",
    "@saflib/base-sdk": "*",
    "@saflib/base-spec": "*",
    "@saflib/errors-vue": "*",
    "@saflib/links": "*",
    "@saflib/ory-kratos-sdk": "*",
    "@saflib/sdk": "*",
    "@saflib/vendors-sentry": "*",
    "@saflib/vue": "*"
  },
  "sideEffects": [
    "./clients/events.ts"
  ],
  "imports": {
    "#assets/*": "./assets/*",
    "#clients": "./clients/index.ts",
    "#clients/*": "./clients/*",
    "#components": "./components/index.ts",
    "#components/*": "./components/*",
    "#composables/*": "./composables/*",
    "#fixtures": "./fixtures/index.ts",
    "#fixtures/*": "./fixtures/*",
    "#i18n.ts": "./i18n.ts",
    "#playwright.config.ts": "./playwright.config.ts",
    "#strings.ts": "./strings.ts",
    "#utils/*": "./utils/*",
    "#vuetify-config.ts": "./vuetify-config.ts"
  }
}
