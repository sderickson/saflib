{
  "name": "@saflib/base-__offshoot-name__-sdk",
  "saf": {
    "kind": "sdk"
  },
  "description": "Offshoot SDK for Base __offshoot-name__: its own API client, requests and fakes",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./requests/*": "./requests/*.ts",
    "./client": "./client.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@saflib/base-__offshoot-name__-spec": "*",
    "@saflib/base-sdk-common": "*",
    "@saflib/monorepo": "*",
    "@saflib/sdk": "*",
    "@saflib/vue": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false,
  "imports": {
    "#requests/*": "./requests/*",
    "#client.ts": "./client.ts"
  }
}
