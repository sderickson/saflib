# prod-local values for __product-name__.Caddyfile (`saf-deploy register-sites --local`).
DOMAIN=__product-name__.docker.localhost
PROTOCOL=http
DOMAIN_REDIRECTS=http://dne.__product-name__.docker.localhost
# Explicit subdomains; evil.localhost is not in this list.
CORS_ORIGINS=^http://(app|auth|admin|account)\.__product-name__\.docker\.localhost$|^http://__product-name__\.docker\.localhost$
CSP_CONNECT_SRC=http://api.__product-name__.docker.localhost http://kratos.__product-name__.docker.localhost https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io
CSP_SCRIPT_SRC_EXTRA=http://kratos.__product-name__.docker.localhost
CSP_REPORT_URI=http://api.__product-name__.docker.localhost/csp-violations
