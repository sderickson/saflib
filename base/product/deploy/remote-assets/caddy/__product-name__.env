# Values for __product-name__.Caddyfile's {$...} placeholders, filled in when
# this deploy registers its routes. Literal values (no `$$` escaping).
DOMAIN=__domain-name__
PROTOCOL=https
# Redirect old/alternate hostnames to DOMAIN.
DOMAIN_REDIRECTS=https://www.__domain-name__
# RE2: allowed browser Origins for CORS on api.* and kratos.*.
CORS_ORIGINS=^https://(app|auth|admin|account)\.__domain-name__$|^https://__domain-name__$
# Space-separated origins for CSP connect-src on HTML sites.
CSP_CONNECT_SRC=https://api.__domain-name__ https://kratos.__domain-name__ https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io
# Kratos public origin for Ory webauthn.js (passkeys).
CSP_SCRIPT_SRC_EXTRA=https://kratos.__domain-name__
# Browser CSP violation reports (POST /csp-violations on the product API).
CSP_REPORT_URI=https://api.__domain-name__/csp-violations
