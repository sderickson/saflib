{
  "name": "@saflib/ops-db",
  "description": "Db and queries for the ops API: machine tokens for agents reading product telemetry.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./instances": "./instances.ts",
    "./tokens": "./tokens.ts",
    "./queries/*": "./queries/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate && saf-drizzle check-migrations",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/drizzle": "*",
    "@saflib/env": "*",
    "drizzle-orm": "^0.45.2",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "drizzle-kit": "*"
  },
  "sideEffects": false
}
