{
  "name": "@saflib/commander",
  "saf": {
    "kind": "lib"
  },
  "description": "Shared commander utilities for SAF CLI applications",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./workflows": "./workflows/index.ts"
  },
  "scripts": {
