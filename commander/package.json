  },
  "dependencies": {
    "@saflib/node": "*",
    "commander": "^14.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
