{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "."
  },
  "references": [
    {
      "path": "../../drizzle"
    },
    {
      "path": "../../express"
    },
    {
      "path": "../../node"
    },
    {
      "path": "../../notify"
    },
    {
      "path": "../../openapi"
    },
    {
      "path": "../../utils"
    },
    {
      "path": "../db"
    },
    {
      "path": "../lib"
    },
    {
      "path": "../spec"
    }
  ]
}
