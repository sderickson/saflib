{
  "openapi": "3.1.0",
  "info": {
    "title": "getWorkflowRunStepTree",
    "version": "1.0.0"
  },
  "paths": {
    "/api/runs/{runId}/step-tree": {
      "get": {
        "summary": "Step tree for a run (including nested call-workflow children)",
        "description": "Indented outline of every step under this run, with slash-separated path addresses suitable for `gotoWorkflowRun`. Nested definitions appear even before a child run has been created.\n",
        "operationId": "getWorkflowRunStepTree",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0SG36FJe6m4W"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Step tree rooted at this run.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/workflow-step-tree-node"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No run with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "workflow-step-tree-node": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "index",
          "kind",
          "isCurrent"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Slash-separated indices from the root (e.g. `2/4`).",
            "example": "2/4"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Step index within this node's own workflow definition."
          },
          "kind": {
            "type": "string",
            "example": "call-workflow"
          },
          "label": {
            "type": "string",
            "description": "Best-effort human label for the step."
          },
          "isCurrent": {
            "type": "boolean",
            "description": "True when this node is on the active breadcrumb."
          },
          "runId": {
            "type": "string",
            "description": "Owning run id when one exists. Absent for nested outline rows under a `call-workflow` that has not created a child yet.\n"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/workflow-step-tree-node"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}