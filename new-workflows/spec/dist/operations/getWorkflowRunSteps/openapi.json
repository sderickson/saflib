{
  "openapi": "3.1.0",
  "info": {
    "title": "getWorkflowRunSteps",
    "version": "1.0.0"
  },
  "paths": {
    "/api/runs/{runId}/steps": {
      "get": {
        "summary": "List a run's workflow steps",
        "description": "The full step list for the run's workflow definition (resolved the same way `advance` resolves it — a registered code id or a plan file path), for a sidebar/outline view. Best-effort `label` per step: the step's own rendered input where that's safe to compute without executing it, else just the step `kind`.\n",
        "operationId": "getWorkflowRunSteps",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0SG36FJe6m4W"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run's steps, in execution order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/workflow-run-step"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No run with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "workflow-run-step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "kind"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "example": "call-workflow"
          },
          "label": {
            "type": "string",
            "description": "Best-effort human-readable summary of the step's input.",
            "example": "drizzle/add-query"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key/value breakdown of this step's own input fields (e.g. a call-workflow step's targetInput), for a detail list in the UI instead of cramming everything into `label`.\n",
            "example": {
              "path": "./schemas/todo.ts"
            }
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}