{
  "openapi": "3.1.0",
  "info": {
    "title": "new-workflows API",
    "version": "1.0.0",
    "description": "HTTP surface + shared business-object schemas for the sqlite-backed workflows engine rewrite (see new-workflows/plans/spec.md). Mounted into dev-site-http as monolith chrome, not run as a standalone service — see new-workflows-http's docs. The SSE run-events route (GET /api/runs/{runId}/events) is intentionally not modeled here; text/event-stream doesn't fit request/response validation and isn't a validated operation, matching node-log-http's precedent.\n"
  },
  "paths": {
    "/api/workflows": {
      "get": {
        "summary": "List registered workflows",
        "description": "Code-defined workflows from the server's registry. Config-defined (`workflow_configs`) workflows aren't included yet — nothing creates them via this API surface today.\n",
        "operationId": "listWorkflows",
        "responses": {
          "200": {
            "description": "Registered workflows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "workflows"
                  ],
                  "properties": {
                    "workflows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/workflow-summary"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/workflows/{id}/runs": {
      "post": {
        "summary": "Start a run of a registered workflow",
        "operationId": "createWorkflowRun",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "A registered workflow's id, or a plan file's `path` (from GET /plans) to run a config-defined workflow.\n",
            "schema": {
              "type": "string",
              "example": "example/hello"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "mode": {
                    "$ref": "#/components/schemas/workflow-run-mode"
                  },
                  "agentConfig": {
                    "$ref": "#/components/schemas/workflow-run-agent-config"
                  },
                  "skipTodos": {
                    "type": "boolean"
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Overrides the mount's default working directory (e.g. dev-site's repo checkout root) for this run.\n",
                    "example": "/home/user/my-project"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run"
                  ],
                  "properties": {
                    "run": {
                      "$ref": "#/components/schemas/workflow-run"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No registered workflow with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}": {
      "get": {
        "summary": "Get a run by id",
        "operationId": "getWorkflowRun",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0SG36FJe6m4W"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run detail.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run"
                  ],
                  "properties": {
                    "run": {
                      "$ref": "#/components/schemas/workflow-run"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No run with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}/advance": {
      "post": {
        "summary": "Run the next step of a run",
        "description": "The HTTP face of `new-workflows/lib`'s single \"run next step\" entry point — the caller (this endpoint's caller) decides whether/when to call it again. Persists the step's output to `workflow_logs` and publishes a change hint on this run's SSE channel as a side effect.\n",
        "operationId": "advanceWorkflowRun",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0SG36FJe6m4W"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Outcome of the step that just ran.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/step-result"
                }
              }
            }
          },
          "404": {
            "description": "No run with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}/cancel": {
      "post": {
        "summary": "Stop the agent turn currently running for a run, if any",
        "description": "Kills the in-process agent subprocess for this run (e.g. a `claude -p` call in flight from a concurrent `advance` request), if one is running. That `advance` call's own response then resolves on its own with a `status: \"error\"` outcome — this endpoint doesn't wait for it. A no-op (returns `cancelled: false`) if nothing was running, including the common race where the agent had already finished.\n",
        "operationId": "cancelWorkflowRun",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0SG36FJe6m4W"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whether a running agent process was found and asked to stop.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cancelled"
                  ],
                  "properties": {
                    "cancelled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}/logs": {
      "get": {
        "summary": "List a run's logs",
        "description": "Cursor-paginated by `since` (an ISO timestamp) — the client re-fetches this after an SSE change hint rather than getting log content pushed over the wire.\n",
        "operationId": "listWorkflowRunLogs",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0SG36FJe6m4W"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Only rows created strictly after this timestamp.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Log rows, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "logs"
                  ],
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/workflow-log-entry"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No run with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans": {
      "get": {
        "summary": "List saved plans (config-defined workflow folders)",
        "description": "Scans the plans root (e.g. `test-product/plans/`) for folders holding workflow config files, newest-first.\n",
        "operationId": "listPlans",
        "responses": {
          "200": {
            "description": "Plans under the plans root.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "plans"
                  ],
                  "properties": {
                    "plans": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/plan-summary"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "This host hasn't configured a plans folder.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save a new plan (a config-defined workflow) to the plans folder",
        "description": "Writes `<plansRoot>/<date>-<name>/<name>.yaml` with the given config body. Doesn't run it — see POST /workflows/{id}/runs with the returned file's `path` as `id`.\n",
        "operationId": "createPlan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "body"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "kebab-case slug used for the folder and file name.",
                    "example": "add-list-users-query"
                  },
                  "body": {
                    "$ref": "#/components/schemas/workflow-config-body"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Plan created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "plan"
                  ],
                  "properties": {
                    "plan": {
                      "$ref": "#/components/schemas/plan-summary"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid plan name or config body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "This host hasn't configured a plans folder.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "$ref": "#/components/schemas/error"
      },
      "WorkflowRunMode": {
        "$ref": "#/components/schemas/workflow-run-mode"
      },
      "WorkflowRunStatus": {
        "$ref": "#/components/schemas/workflow-run-status"
      },
      "WorkflowStepStatus": {
        "$ref": "#/components/schemas/workflow-step-status"
      },
      "WorkflowLogChannel": {
        "$ref": "#/components/schemas/workflow-log-channel"
      },
      "WorkflowLogLevel": {
        "$ref": "#/components/schemas/workflow-log-level"
      },
      "WorkflowRunAgentConfig": {
        "$ref": "#/components/schemas/workflow-run-agent-config"
      },
      "WorkflowConfigBody": {
        "$ref": "#/components/schemas/workflow-config-body"
      },
      "WorkflowSummary": {
        "$ref": "#/components/schemas/workflow-summary"
      },
      "WorkflowRun": {
        "$ref": "#/components/schemas/workflow-run"
      },
      "WorkflowLogEntry": {
        "$ref": "#/components/schemas/workflow-log-entry"
      },
      "StepResult": {
        "$ref": "#/components/schemas/step-result"
      },
      "PlanFile": {
        "$ref": "#/components/schemas/plan-file"
      },
      "PlanSummary": {
        "$ref": "#/components/schemas/plan-summary"
      },
      "workflow-summary": {
        "type": "object",
        "description": "One entry in the registered-workflow list (`GET /workflows`).",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "A code workflow's `defineWorkflow` id, or a `workflow_config` row id.",
            "example": "example/hello"
          },
          "description": {
            "type": "string",
            "example": "Copies a template file, prompts about it, and runs a command."
          },
          "source": {
            "type": "string",
            "enum": [
              "code",
              "config"
            ],
            "description": "Whether this is a code-defined or config-defined workflow.",
            "example": "code"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": true,
            "description": "The workflow's declared input schema (`new-workflows/lib`'s `WorkflowInputSchema`), if it has one — a generic passthrough here rather than a fully modeled schema, since it's already well-typed on the TypeScript side and a client only needs it to build a form.\n"
          }
        }
      },
      "workflow-run-mode": {
        "type": "string",
        "description": "Execution mode for a run, set once at `createRun` and unchanged for its lifetime. Same modes as today's `@saflib/workflows`: `dry`/`checklist` never touch the filesystem or run commands; `script` runs mechanical steps (copy, command) but skips prompts, TODO checks, and validation commands (typecheck/test); `print` hands prompts to an external agent and halts between steps; `run` drives the agent itself.\n",
        "enum": [
          "dry",
          "script",
          "print",
          "run",
          "checklist"
        ],
        "example": "run"
      },
      "workflow-run-agent-config": {
        "type": "object",
        "description": "Which agent CLI drives a run's `run`-mode steps, and its resumable session. Set at `createRun` (or when the run is retried against a different agent) and persisted on the run row so a resumed process can `--resume` the same underlying session.\n",
        "additionalProperties": false,
        "required": [
          "cli"
        ],
        "properties": {
          "cli": {
            "type": "string",
            "description": "Agent CLI adapter to use. `mock-agent` is test-only (no subprocess).\n",
            "enum": [
              "cursor-agent",
              "claude-agent",
              "mock-agent"
            ],
            "example": "cursor-agent"
          },
          "sessionId": {
            "type": "string",
            "description": "Session id returned by the agent CLI's first turn, passed back on subsequent turns (e.g. `--resume`) so multi-turn steps share context.\n",
            "example": "a1b2c3d4"
          }
        },
        "example": {
          "cli": "cursor-agent",
          "sessionId": "a1b2c3d4"
        }
      },
      "workflow-run-status": {
        "type": "string",
        "description": "Lifecycle state of a run. `pending` before the first step runs; `running` after a step succeeds with more steps left; `awaiting_prompt`/ `awaiting_user` after a step hands control back to the caller (an agent prompt or a human action is needed before advancing again); `done`/ `failed` are terminal.\n",
        "enum": [
          "pending",
          "running",
          "awaiting_prompt",
          "awaiting_user",
          "done",
          "failed"
        ],
        "example": "running"
      },
      "workflow-run": {
        "type": "object",
        "description": "A single workflow run — the wire form of a `workflow_run` row (`new-workflows-db/schemas/workflow-run.ts`).\n",
        "additionalProperties": false,
        "required": [
          "id",
          "workflow_source",
          "workflow_ref",
          "input",
          "mode",
          "skip_todos",
          "status",
          "current_step_index",
          "cwd",
          "agent_config",
          "parent_run_id",
          "parent_step_index",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "0SG36FJe6m4W"
          },
          "workflow_source": {
            "type": "string",
            "enum": [
              "code",
              "config"
            ],
            "example": "code"
          },
          "workflow_ref": {
            "type": "string",
            "description": "A code workflow's `defineWorkflow` id, or a `workflow_config` row id.",
            "example": "example/hello"
          },
          "input": {
            "type": "object",
            "description": "The input this run was started with.",
            "additionalProperties": true
          },
          "mode": {
            "$ref": "#/components/schemas/workflow-run-mode"
          },
          "skip_todos": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/workflow-run-status"
          },
          "current_step_index": {
            "type": "integer",
            "example": 1
          },
          "cwd": {
            "type": "string",
            "example": "/home/user/my-project"
          },
          "agent_config": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/workflow-run-agent-config"
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_run_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when this run was spawned by a `call-workflow` step in another run."
          },
          "parent_step_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      },
      "step-result": {
        "description": "Result of advancing a run by one step (`POST /runs/{runId}/advance`) — the wire form of `new-workflows/lib`'s `StepResult`.\n",
        "discriminator": {
          "propertyName": "status"
        },
        "oneOf": [
          {
            "type": "object",
            "description": "The step succeeded; more steps remain.",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "success"
                ],
                "example": "success"
              },
              "result": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          {
            "type": "object",
            "description": "The step failed.",
            "additionalProperties": false,
            "required": [
              "status",
              "message"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "error"
                ],
                "example": "error"
              },
              "message": {
                "type": "string"
              },
              "errorPrompt": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "description": "Waiting on the agent (mode `print`, or `run` after a timeout).",
            "additionalProperties": false,
            "required": [
              "status",
              "prompt"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "awaiting_prompt"
                ],
                "example": "awaiting_prompt"
              },
              "prompt": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "description": "Waiting on a human action outside the agent loop.",
            "additionalProperties": false,
            "required": [
              "status",
              "message"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "awaiting_user"
                ],
                "example": "awaiting_user"
              },
              "message": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "description": "No more steps to run.",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "done"
                ],
                "example": "done"
              }
            }
          }
        ]
      },
      "workflow-log-channel": {
        "type": "string",
        "description": "Which output channel a log line belongs to, so a renderer (CLI or web) can style/route it distinctly instead of guessing from content. `terminal`: raw stdout/stderr from a subprocess the workflow ran (vite, npm, git). `agent`: output from the coding agent (what it said, what it executed). `tool`: the workflow engine's own narration (e.g. \"running step 3: copy\"). `agent-input`: the prompt text sent to the agent.\n",
        "enum": [
          "terminal",
          "agent",
          "tool",
          "agent-input"
        ],
        "example": "tool"
      },
      "workflow-log-level": {
        "type": "string",
        "description": "Severity of a single log line, independent of its channel.",
        "enum": [
          "info",
          "warn",
          "error"
        ],
        "example": "info"
      },
      "workflow-log-entry": {
        "type": "object",
        "description": "One log line for a run — the wire form of a `workflow_log` row (`new-workflows-db/schemas/workflow-log.ts`).\n",
        "additionalProperties": false,
        "required": [
          "id",
          "run_id",
          "step_index",
          "channel",
          "level",
          "content",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "aBcD1234"
          },
          "run_id": {
            "type": "string",
            "example": "0SG36FJe6m4W"
          },
          "step_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "channel": {
            "$ref": "#/components/schemas/workflow-log-channel"
          },
          "level": {
            "$ref": "#/components/schemas/workflow-log-level"
          },
          "content": {
            "type": "string",
            "example": "Generated \"example-thing.ts\" from template"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "plan-file": {
        "type": "object",
        "description": "One workflow config file inside a plan folder.",
        "additionalProperties": false,
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "add-list-users-query.yaml"
          },
          "path": {
            "type": "string",
            "description": "Path usable as the `id` in POST /workflows/{id}/runs — relative to the repo root.\n",
            "example": "test-product/plans/2026-09-15-add-list-users-query/add-list-users-query.yaml"
          }
        }
      },
      "plan-summary": {
        "type": "object",
        "description": "A folder under the plans root (e.g. `test-product/plans/`) holding one or more workflow config files — a one-off plan authored outside a code-defined workflow. Folder naming convention: `<date>-<name>`.\n",
        "additionalProperties": false,
        "required": [
          "folder",
          "name",
          "files"
        ],
        "properties": {
          "folder": {
            "type": "string",
            "example": "2026-09-15-add-list-users-query"
          },
          "name": {
            "type": "string",
            "description": "Human name portion of the folder (after the date prefix).",
            "example": "add-list-users-query"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/plan-file"
            }
          }
        }
      },
      "workflow-config-body": {
        "type": "object",
        "description": "Body of a one-off, config-defined workflow (a `workflow_config` row) — a name, an optional description, and a list of steps, so no TypeScript is required to author one.\n\nConfig workflows get `prompt`/`command`/`cd`/`npm-script`, plus `call-workflow` to invoke another workflow (typically a reusable, code-defined one) as a nested run. `copy`/`update`/`transform-file` stay code-only: templates are worth building and maintaining for reusable workflows, but a one-off config workflow shouldn't need one — if it needs templated scaffolding, it calls a code-defined workflow that already does that instead of duplicating the logic.\n",
        "additionalProperties": false,
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name shown in the CLI/dev-site, not the run id.",
            "example": "Add a demo feature flag"
          },
          "description": {
            "type": "string",
            "description": "Longer explanation of what this workflow does and when to use it.",
            "example": "Scaffolds a new feature flag: adds the flag constant, wires it into the admin toggle list, and runs typecheck.\n"
          },
          "steps": {
            "type": "array",
            "description": "Executed in order by `new-workflows/lib`'s `advanceRun`.",
            "items": {
              "discriminator": {
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "type": "object",
                  "description": "Prompts the agent (or, in `print` mode, the caller) to do an arbitrary task.",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "prompt"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "prompt"
                      ],
                      "example": "prompt"
                    },
                    "prompt": {
                      "type": "string",
                      "example": "Run the drizzle migration and confirm it applied cleanly."
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "Runs a shell command.",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "command"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "command"
                      ],
                      "example": "command"
                    },
                    "command": {
                      "type": "string",
                      "example": "npm"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "run",
                        "typecheck"
                      ]
                    },
                    "ignoreError": {
                      "type": "boolean",
                      "description": "Treat a non-zero exit as success.",
                      "default": false
                    },
                    "errorPrompt": {
                      "type": "string",
                      "description": "Extra text shown to the agent alongside the failure, in `run` mode."
                    },
                    "forceInScript": {
                      "type": "boolean",
                      "description": "Run even in `script` mode if it would otherwise be treated as a skipped validation command (typecheck/test).\n",
                      "default": false
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "Changes the working directory for subsequent steps.",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "path"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "cd"
                      ],
                      "example": "cd"
                    },
                    "path": {
                      "type": "string",
                      "description": "Absolute, or relative to the run's original working directory.",
                      "example": "packages/my-lib"
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "Runs `npm run <script> -w <workspace>`, validating both exist first.",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "workspace",
                    "script"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "npm-script"
                      ],
                      "example": "npm-script"
                    },
                    "workspace": {
                      "type": "string",
                      "example": "@saflib/new-workflows"
                    },
                    "script": {
                      "type": "string",
                      "example": "test"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ignoreError": {
                      "type": "boolean",
                      "default": false
                    },
                    "errorPrompt": {
                      "type": "string"
                    },
                    "forceInScript": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "Calls another workflow — typically a reusable, code-defined one — as a nested run, blocking this step until it completes.\n",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "workflowId"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "call-workflow"
                      ],
                      "example": "call-workflow"
                    },
                    "workflowId": {
                      "type": "string",
                      "description": "A code-defined workflow's id, or a path to another workflow file (.ts for code, .json/.yaml for another config).\n",
                      "example": "vue/add-view"
                    },
                    "input": {
                      "type": "object",
                      "description": "Input for the target workflow.",
                      "additionalProperties": true
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "workflow-step-status": {
        "type": "string",
        "description": "Outcome of a single step attempt row. `running` while the step is in flight (the row is inserted before the step function is called); `success`/`error` are the two terminal outcomes for a step; `awaiting_prompt`/ `awaiting_user` mean the step handed control back to the caller without finishing — the same step index will be attempted again on the next `advance` call.\n",
        "enum": [
          "running",
          "success",
          "error",
          "awaiting_prompt",
          "awaiting_user"
        ],
        "example": "success"
      }
    }
  }
}
