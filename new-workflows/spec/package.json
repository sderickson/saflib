{
  "name": "@saflib/new-workflows-spec",
  "saf": {
    "kind": "spec"
  },
  "description": "Shared business-object schemas for the sqlite-backed workflows engine rewrite. No HTTP paths yet — see new-workflows-http (later phase).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./openapi.yaml": "./openapi.yaml",
    "./schemas/*": "./dist/schemas/*/index.ts"
  },
  "scripts": {
    "build": "saf-specs generate -f openapi.yaml -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "generate": "npm exec saf-specs generate"
  },
  "dependencies": {
    "@saflib/openapi": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
