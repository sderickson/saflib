{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "."
  },
  "references": [
    {
      "path": "../../commander"
    },
    {
      "path": "../../cron-http-workflows"
    },
    {
      "path": "../../drizzle"
    },
    {
      "path": "../../drizzle-workflows"
    },
    {
      "path": "../../email-service-workflows"
    },
    {
      "path": "../../env-workflows"
    },
    {
      "path": "../../express-workflows"
    },
    {
      "path": "../../git"
    },
    {
      "path": "../../integrations-workflows"
    },
    {
      "path": "../../jobs-http-workflows"
    },
    {
      "path": "../../monorepo-workflows"
    },
    {
      "path": "../../node"
    },
    {
      "path": "../../openapi-workflows"
    },
    {
      "path": "../../processes-workflows"
    },
    {
      "path": "../../sdk-workflows"
    },
    {
      "path": "../../service-workflows"
    },
    {
      "path": "../../vue-workflows"
    },
    {
      "path": "../db"
    },
    {
      "path": "../lib"
    },
    {
      "path": "../spec"
    }
  ]
}
