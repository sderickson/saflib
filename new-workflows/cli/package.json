{
  "name": "@saflib/new-workflows-cli",
  "saf": {
    "kind": "lib"
  },
  "description": "CLI wrapper (parity with @saflib/workflows-cli) for the sqlite-backed workflows engine rewrite.",
  "private": true,
  "type": "module",
  "bin": {
    "new-workflow": "./bin/new-workflow/index.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/cron-http-workflows": "*",
    "@saflib/drizzle": "*",
    "@saflib/drizzle-workflows": "*",
    "@saflib/email-service-workflows": "*",
    "@saflib/env-workflows": "*",
    "@saflib/express-workflows": "*",
    "@saflib/git": "*",
    "@saflib/integrations-workflows": "*",
    "@saflib/jobs-http-workflows": "*",
    "@saflib/monorepo-workflows": "*",
    "@saflib/new-workflows": "*",
    "@saflib/new-workflows-db": "*",
    "@saflib/new-workflows-spec": "*",
    "@saflib/node": "*",
    "@saflib/openapi-workflows": "*",
    "@saflib/processes-workflows": "*",
    "@saflib/product-workflows": "*",
    "@saflib/sdk-workflows": "*",
    "@saflib/service-workflows": "*",
    "@saflib/vue-workflows": "*"
  },
  "devDependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
