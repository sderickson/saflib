{
  "extends": [
    "@saflib/vue/tsconfig.app.json"
  ],
  "references": [
    {
      "path": "../cron/cron-vue"
    },
    {
      "path": "../email/email-vue"
    },
    {
      "path": "../vue"
    }
  ],
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ]
}
