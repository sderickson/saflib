{
  "name": "@saflib/node",
  "saf": {
    "kind": "lib"
  },
  "description": "Reusable Node.js utilities",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./git-hashes": "./src/git-hashes.ts",
    "./cli-context": "./src/cli-context.ts",
    "./env": "./env.ts"
  },
  "scripts": {
