    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/env": "*",
    "@saflib/node-log-http": "*",
    "@saflib/secret-store": "*",
