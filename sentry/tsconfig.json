{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types"
  },
  "references": [
    {
      "path": "../env"
    },
    {
      "path": "../node"
    },
    {
      "path": "../vitest"
    },
    {
      "path": "../workflows"
    }
  ]
}
