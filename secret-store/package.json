{
  "name": "@saflib/secret-store",
  "saf": {
    "kind": "lib",
    "envExtends": ["@saflib/env"]
  },
  "description": "Secret store library for env-backed and Infisical-backed secret resolution",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.0",
    "@saflib/env": "*"
  },
  "devDependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
