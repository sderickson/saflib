{
  "name": "@saflib/openapi",
  "saf": {
    "kind": "lib"
  },
  "description": "Shared dependencies for generating OpenAPI specs in SAF projects",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./ajv-formats": "./ajv-formats.ts",
    "./error": "./error.ts",
    "./openapi.yaml": "./openapi.yaml",
    "./schemas/Error": "./schemas/Error.ts",
    "./schemas/error.yaml": "./schemas/error.yaml",
    "./workflows": "./workflows/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "bin": {
    "saf-specs": "./bin/saf-specs/index.ts"
  },
  "dependencies": {
    "@redocly/openapi-core": "^2.0.0",
    "@saflib/templates": "*",
    "openapi-typescript": "^7.13.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "serve": "^14.0.0"
  },
  "sideEffects": false
}
