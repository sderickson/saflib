{
  "openapi": "3.1.0",
  "info": {
    "title": "@saflib/openapi API",
    "version": "1.0.0",
    "description": "Shared OpenAPI schemas and types for the platform"
  },
  "components": {
    "schemas": {
      "Error": {
        "$ref": "#/components/schemas/error"
      },
      "Address": {
        "$ref": "#/components/schemas/address"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      },
      "address": {
        "type": "object",
        "description": "A shared address type that can be used across the platform",
        "properties": {
          "formatted": {
            "type": [
              "string",
              "null"
            ],
            "description": "Complete formatted address string",
            "example": "123 Main St, Anytown, ST 12345, USA"
          },
          "street_address": {
            "type": [
              "string",
              "null"
            ],
            "description": "Street address line",
            "example": "123 Main St"
          },
          "locality": {
            "type": [
              "string",
              "null"
            ],
            "description": "City or town name",
            "example": "Anytown"
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "description": "State, province, or region",
            "example": "ST"
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "description": "Country name",
            "example": "USA"
          },
          "postal_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "ZIP or postal code",
            "example": "12345"
          }
        },
        "example": {
          "formatted": "123 Main St, Anytown, ST 12345, USA",
          "street_address": "123 Main St",
          "locality": "Anytown",
          "region": "ST",
          "country": "USA",
          "postal_code": "12345"
        }
      }
    }
  }
}
