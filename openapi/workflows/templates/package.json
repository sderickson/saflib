{
  "name": "template-package-spec",
  "saf": {
    "kind": "spec"
  },
  "description": "API specs for the __service-name__ service",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./operations/*": "./dist/operations/*/index.ts",
    "./schemas/*": "./dist/schemas/*/index.ts"
  },
  "scripts": {
    "build": "saf-specs generate -f openapi.yaml -o dist",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/openapi": "*"
  },
  "sideEffects": false
}
