{
  "name": "@saflib/env",
  "saf": {
    "kind": "lib"
  },
  "description": "Specify, share, and enforce environment variables",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./env": "./env.ts",
    "./workflows": "./workflows/index.ts"
  },
  "bin": {
    "saf-env": "./src/saf-env-cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/monorepo": "*",
    "@saflib/templates": "*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "json-schema-to-typescript": "^15.0.4"
  },
  "sideEffects": false
}
