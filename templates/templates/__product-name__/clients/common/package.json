{
  "name": "@saflib/templates-clients-common",
  "description": "Shared look-and-feel and utilities for web clients",
  "private": true,
  "type": "module",
  "exports": {
    "./assets/*": "./assets/*.ts",
    "./clients": "./clients/index.ts",
    "./clients/*": "./clients/*.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*.ts",
    "./composables/*": "./composables/*.ts",
    "./fixtures": "./fixtures/index.ts",
    "./fixtures/*": "./fixtures/*.ts",
    "./utils/*": "./utils/*.ts",
    "./vuetify-config": "./vuetify-config.ts",
    "./strings": "./strings.ts",
    "./i18n": "./i18n.ts",
    "./playwright.config": "./playwright.config.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@saflib/vue": "*",
    "@sentry/vue": "^10.21.0",
    "@saflib/ory-kratos-sdk": "*",
    "@saflib/templates-spec": "*"
  },
  "sideEffects": false
}
