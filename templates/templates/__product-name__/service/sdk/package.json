{
  "name": "@saflib/templates-sdk",
  "saf": {
    "kind": "sdk"
  },
  "description": "Tanstack queries and shared components for templates service",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./client.ts",
    "./fakes": "./fakes.ts",
    "./i18n": "./i18n.ts",
    "./strings": "./strings.ts",
    "./test-app": "./test-app.ts",
    "./typed-fake": "./typed-fake.ts",
    "./requests/*": "./requests/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@testing-library/vue": "^8.1.0"
  },
  "dependencies": {
    "@saflib/monorepo": "*",
    "@saflib/sdk": "*",
    "@saflib/templates-spec": "*",
    "@saflib/vue": "*",
    "@saflib/ory-kratos-sdk": "*",
    "msw": "^2.11.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "sideEffects": [
    "./client.ts"
  ]
}
