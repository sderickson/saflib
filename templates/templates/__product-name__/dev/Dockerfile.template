# syntax=docker/dockerfile:labs

# Requires a local tag first: saflib/templates-dev `build-images.sh`
# builds static-root (in parallel with monolith/clients) before compose.
# Logged-out templates marketing site — same base image as deploy (__product-name__/clients/root).
FROM saflib-templates-static-root:latest AS static-root-builder
RUN npm run build

# Monorepo install once — workspace closure of saflib/templates-dev (templates static builds for this stack).
FROM node:24-slim AS deps

RUN npm install -g npm@11.14.1

WORKDIR /app

#{ copy_packages }#
RUN npm ci --omit=dev

#{ copy_src }#

FROM caddy:2.11.3
COPY --from=static-root-builder /app/__product-name__/clients/root/.vitepress/dist /srv/__product-name__-static-root
