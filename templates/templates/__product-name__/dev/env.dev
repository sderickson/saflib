# @saflib/env
ALLOW_DB_CREATION=true
DEPLOYMENT_NAME=development
NODE_ENV=development
PROTOCOL=http
TZ=UTC

# templates-specific @saflib/env
TRADEMARK=Templates
DOMAIN=docker.localhost
CLIENT_SUBDOMAINS=,auth,app,admin,account
SERVICE_SUBDOMAINS=templates

KRATOS_HANDLER_HTTP_HOST=templates-monolith:3000
SENTRY_DSN=mock

# @saflib/email
NODEMAILER_TRANSPORT_CONFIG=

# @saflib/templates-http
TEMPLATES_SERVICE_HTTP_HOST=monolith:3001

ADMIN_EMAILS=admin@saflib.com