# Curried snippets

(__product-name__-spa) {
	import spa /__product-name__-clients {args[0]}
}

# Client subdomains

{$TEMPLATES_PROTOCOL}://{$TEMPLATES_DOMAIN} {
	import static-site /__product-name__-root
}

{$TEMPLATES_PROTOCOL}://auth.{$TEMPLATES_DOMAIN} {
	import __product-name__-spa /auth/index.html
}

{$TEMPLATES_PROTOCOL}://app.{$TEMPLATES_DOMAIN} {
	import __product-name__-spa /app/index.html
}

{$TEMPLATES_PROTOCOL}://admin.{$TEMPLATES_DOMAIN} {
	import __product-name__-spa /admin/index.html
}

{$TEMPLATES_PROTOCOL}://account.{$TEMPLATES_DOMAIN} {
	import __product-name__-spa /account/index.html
}

# API subdomains

{$TEMPLATES_PROTOCOL}://templates.{$TEMPLATES_DOMAIN} {
	import cors {$DOMAIN}
	import kratos-api-proxy {$TEMPLATES_SERVICE_HTTP_HOST}
}

{$TEMPLATES_PROTOCOL}://kratos.{$TEMPLATES_DOMAIN} {
	import cors {$TEMPLATES_DOMAIN}
	reverse_proxy kratos:4433
}

{$TEMPLATES_PROTOCOL}://grafana.{$TEMPLATES_DOMAIN} {
	import cors {$TEMPLATES_DOMAIN}
	reverse_proxy grafana:3000 {
		import reverse_proxy_common
	}
}

{$TEMPLATES_DOMAIN_REDIRECTS} {
	import redirect {$TEMPLATES_DOMAIN}
}
