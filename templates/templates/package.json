{
  "name": "@saflib/example",
  "description": "Example monorepo created from @saflib/templates. Rename via product/init.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "vue-tsc -b"
  },
  "workspaces": [
    "__product-name__/**",
    "deploy/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
