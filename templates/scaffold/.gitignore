**/node_modules
**/coverage
**/data/*
# Keep empty data directories (db/data, cron/data, …): images need them to exist.
!**/data/.gitkeep
**/saf-workflow-status.json
**/dist/types
**/.saf-docker
**/.saf-deploy

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs (repo-root only: a bare `logs` would also ignore admin pages/logs routes)
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Playwright
**/test-results
**/playwright-report
**/e2e/**/*.jpeg
**/e2e/**/*.png

# Database
*.sqlite
.env
.env.sentry-build-plugin
# Generated by saf-docker
Dockerfile
Dockerfile.dockerignore
