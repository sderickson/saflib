{
  "name": "@saflib/imports",
  "description": "SAF import-graph measurement and enforcement tooling",
  "private": true,
  "type": "module",
  "bin": {
    "saf-imports": "bin/saf-imports/index.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./reporter": "./reporter.ts",
    "./src/baseline/baseline": "./src/baseline/baseline.ts",
    "./src/budget/check-budgets": "./src/budget/check-budgets.ts",
    "./src/exports/generate-exports": "./src/exports/generate-exports.ts",
    "./src/graph/detect-cycles": "./src/graph/detect-cycles.ts",
    "./src/graph/extract-imports": "./src/graph/extract-imports.ts",
    "./src/graph/find-path": "./src/graph/find-path.ts",
    "./src/graph/read-source": "./src/graph/read-source.ts",
    "./src/graph/walk-graph": "./src/graph/walk-graph.ts",
    "./src/references": "./src/references/index.ts",
    "./src/references/build-graph": "./src/references/build-graph.ts",
    "./src/references/detect-cycles": "./src/references/detect-cycles.ts",
    "./src/references/generate": "./src/references/generate.ts",
    "./src/references/resolve-entry": "./src/references/resolve-entry.ts",
    "./src/references/tsconfig-io": "./src/references/tsconfig-io.ts",
    "./src/reporter/vitest-reporter": "./src/reporter/vitest-reporter.ts",
    "./src/resolve": "./src/resolve/index.ts",
    "./src/types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/commander": "*"
  },
  "devDependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*",
    "vitest": "^3.0.0"
  },
  "sideEffects": [
    "./../../scripts/apply-side-effects.mjs",
    "./../../src/side-effects/scan-package.ts"
  ]
}
