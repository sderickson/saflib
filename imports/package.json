{
  "name": "@saflib/imports",
  "description": "SAF import-graph measurement and enforcement tooling",
  "private": true,
  "type": "module",
  "bin": {
    "saf-imports": "bin/saf-imports/index.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./facts": "./src/facts/index.ts",
    "./issues": "./src/issues/index.ts",
    "./reporter": "./reporter.ts",
    "./src/snapshot/snapshot": "./src/snapshot/snapshot.ts",
    "./src/exports/generate-exports": "./src/exports/generate-exports.ts",
    "./src/graph/detect-cycles": "./src/graph/detect-cycles.ts",
    "./src/graph/extract-imports": "./src/graph/extract-imports.ts",
    "./src/graph/find-path": "./src/graph/find-path.ts",
    "./src/graph/read-source": "./src/graph/read-source.ts",
    "./src/graph/walk-graph": "./src/graph/walk-graph.ts",
    "./src/graph/assemble-used-by": "./src/graph/assemble-used-by.ts",
    "./src/graph/import-resolution": "./src/graph/import-resolution.ts",
    "./src/tsconfig": "./src/tsconfig/index.ts",
    "./src/tsconfig/build-graph": "./src/tsconfig/build-graph.ts",
    "./src/tsconfig/detect-cycles": "./src/tsconfig/detect-cycles.ts",
    "./src/tsconfig/generate": "./src/tsconfig/generate.ts",
    "./src/tsconfig/resolve-entry": "./src/tsconfig/resolve-entry.ts",
    "./src/tsconfig/tsconfig-io": "./src/tsconfig/tsconfig-io.ts",
    "./src/reporter/vitest-reporter": "./src/reporter/vitest-reporter.ts",
    "./src/resolve": "./src/resolve/index.ts",
    "./src/types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/monorepo": "*",
    "@saflib/parser": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "vitest": "^4.0.0"
  },
  "sideEffects": [
    "./../../scripts/apply-side-effects.mjs",
    "./../../src/side-effects/scan-package.ts"
  ]
}
