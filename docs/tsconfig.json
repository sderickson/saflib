{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    {
      "path": "../commander"
    },
    {
      "path": "../monorepo"
    },
    {
      "path": "../node"
    },
    {
      "path": "../utils"
    }
  ],
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["node"],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "node_modules",
    "dist/types"
  ],
  "include": [
    "**/*.ts"
  ]
}
