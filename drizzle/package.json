{
  "name": "@saflib/drizzle",
  "saf": {
    "kind": "lib"
  },
  "description": "Tools, docs, and workflows for using drizzle + better-sqlite3",
  "type": "module",
  "exports": {
    "./workflows": "./workflows/index.ts",
    ".": "./index.ts",
    "./env": "./env.ts"
  },
  "bin": {
    "saf-drizzle": "./bin/saf-drizzle/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/env": "*",
    "@saflib/node": "*",
    "@saflib/templates": "*",
    "@saflib/utils": "*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@types/better-sqlite3": "^7.0.0",
    "drizzle-kit": "^0.31.10"
  },
  "sideEffects": false
}
