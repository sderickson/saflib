{
  "name": "@saflib/dev-site-vue",
  "description": "Vue pages/widgets for browsing static-analysis commit snapshots",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./app": "./app/mount.ts",
    "./router": "./app/router.ts",
    "./vuetify-config": "./app/vuetify-config.ts",
    "./vite-config": "./app/vite-config.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@saflib/dev-site-http": "*",
    "@saflib/dev-site-spec": "*",
    "@saflib/imports": "*",
    "@saflib/links": "*",
    "@saflib/sdk": "*",
    "@saflib/vite": "*",
    "@saflib/vue": "*",
    "@tanstack/vue-query": "*",
    "marked": "^18.0.0",
    "vue-router": "*",
    "vuetify": "*"
  },
  "sideEffects": false
}
