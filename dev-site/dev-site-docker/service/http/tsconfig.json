{
  "extends": [
    "@saflib/vue/tsconfig.app.json"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "node_modules",
    "dist/types",
    "data",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "references": [
    {
      "path": "../../../dev-site-http"
    },
    {
      "path": "../../../../env"
    },
    {
      "path": "../../../../node"
    }
  ]
}
