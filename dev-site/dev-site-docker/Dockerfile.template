# syntax=docker/dockerfile:labs
# Built dev-site: Express API + SPA static assets on one port.
# Generated by `saf-docker generate` from workspace deps of @saflib/dev-site-docker.
# Configure at runtime via DEV_SITE_* env vars (see docker-compose.yaml).
FROM node:24-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g npm@11.14.1

WORKDIR /app

#{ copy_packages }#
RUN npm ci

#{ copy_src }#

WORKDIR #{ package_root }#/clients/app
RUN npm run build

ENV NODE_ENV=production \
  TZ=UTC \
  ALLOW_DB_CREATION=true \
  DEV_SITE_SERVICE_HTTP_HOST=0.0.0.0:3099 \
  DEV_SITE_MAIN_REF=main \
  DEV_SITE_STATIC_DIR=#{ package_root }#/clients/app/dist \
  DEV_SITE_DB_PATH=/data/dev-site.sqlite

WORKDIR #{ package_root }#/service/http
EXPOSE 3099
CMD ["npm", "start"]
