# syntax=docker/dockerfile:labs
# Built dev-site: Express API + SPA static assets on one port.
# Generated by `saf-docker generate` from workspace deps of @saflib/dev-site-docker.
# Configure at runtime via DEV_SITE_* env vars (see docker-compose.yaml).
FROM node:24-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g npm@11.14.1

# For workflow "update" steps run with --run=claude (see @saflib/new-workflows):
# the CLI reads its OAuth session from ~/.claude/.credentials.json, which
# docker-compose.yaml bind-mounts in from the host (see resolve-claude-credentials.sh).
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

#{ copy_packages }#
RUN --mount=type=cache,target=/root/.npm npm ci

#{ copy_src }#

WORKDIR #{ package_root }#/clients/app
RUN npm run build

ENV NODE_ENV=production \
  TZ=UTC \
  ALLOW_DB_CREATION=true \
  DEV_SITE_SERVICE_HTTP_HOST=0.0.0.0:3099 \
  DEV_SITE_MAIN_REF=main \
  DEV_SITE_STATIC_DIR=#{ package_root }#/clients/app/dist \
  DEV_SITE_DB_PATH=/data/dev-site.sqlite

# `--dangerously-skip-permissions` (which the claude-agent adapter always
# passes) refuses to run as root, so the app itself runs as the image's
# built-in non-root `node` user (see docker-entrypoint.sh) — also just
# better hygiene generally. `chown /app`: some packages (e.g.
# new-workflows-db) fall back to a local on-disk sqlite file under their
# own package dir when no explicit path is configured; that tree is
# root-owned from the COPY/npm ci steps above. Pre-create `.claude` too so
# the CLI can write session state there alongside the bind-mounted
# credentials file (see docker-compose.yaml).
RUN mkdir -p /home/node/.claude \
  && chown -R node:node /home/node/.claude /app

# Stays root here (unlike the old `USER node` at this point): the
# entrypoint needs a moment as root to fix ownership on /repo/node_modules
# — a fresh named volume — before dropping to `node` itself. See
# docker-entrypoint.sh for why /repo/node_modules is a separate volume at
# all (never share it with the host). Already present at this path —
# `#{ copy_src }#` above copies this whole package, entrypoint script
# included — so no separate COPY is needed here.
RUN chmod +x #{ package_root }#/docker-entrypoint.sh

WORKDIR #{ package_root }#/service/http
EXPOSE 3099
ENTRYPOINT ["#{ package_root }#/docker-entrypoint.sh"]
CMD ["npm", "start"]
