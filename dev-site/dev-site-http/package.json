{
  "name": "@saflib/dev-site-http",
  "saf": {
    "kind": "http"
  },
  "description": "Dev-site orchestration — scan/store/diff static analysis + Express routes + saf-dev-site CLI",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./http": "./http.ts",
    "./boot": "./boot.ts",
    "./env": "./env.ts",
    "./package-issues": "./package-issues.ts",
    "./testing/slim-route-test": "./testing/slim-route-test.ts",
    "./routes/*": "./routes/*.ts"
  },
  "bin": {
    "saf-dev-site": "./bin/saf-dev-site/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/dev-site-db": "*",
    "@saflib/dev-site-spec": "*",
    "@saflib/drizzle": "*",
    "@saflib/express": "*",
    "@saflib/git": "*",
    "@saflib/imports": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "@saflib/parser": "*",
    "http-errors": "*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
