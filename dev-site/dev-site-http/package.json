    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/dev-site-db": "*",
    "@saflib/dev-site-spec": "*",
    "@saflib/express": "*",
    "@saflib/monorepo": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
