{
  "name": "@saflib/dev-site-http",
  "description": "HTTP server for the dev-site service",
  "type": "module",
  "exports": {
    "./http": "./http.ts",
    "./testing/slim-route-test": "./testing/slim-route-test.ts",
    "./routes/*": "./routes/*.ts"
  },
  "scripts": {
