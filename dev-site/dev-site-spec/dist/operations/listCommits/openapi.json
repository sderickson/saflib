{
  "openapi": "3.1.0",
  "info": {
    "title": "listCommits",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commits": {
      "get": {
        "summary": "List analyzed commits (newest first)",
        "operationId": "listCommits",
        "tags": [
          "no-auth"
        ],
        "description": "Paginated list of analyzed commits with rollup summary metrics for timeline display. Does not include per-package / export / test-case inventories — fetch those via GET /commits/{hash}.\n",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque pagination cursor (commit hash of the last item from the previous page). Omit for the first page.\n"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Max commits to return."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of analyzed commits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "commits"
                  ],
                  "properties": {
                    "commits": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/commit-summary"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` on the next request. Null when there are no more pages.\n"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "commit-summary": {
        "type": "object",
        "description": "List-friendly commit row — same metadata as Commit, without the nested inventory payloads. Used by GET /commits.\n",
        "properties": {
          "hash": {
            "type": "string",
            "description": "Full 40-char commit object hash.",
            "example": "a1b2c3d4e5f6789012345678901234567890abcd"
          },
          "parentHashes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authoredAt": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": "string",
            "description": "Full commit message (subject + body)."
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/commit-ref"
            }
          },
          "analyzerVersion": {
            "type": "string"
          },
          "computedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "complete",
              "failed"
            ]
          },
          "summaryMetrics": {
            "type": "object",
            "description": "Rollup counts across all packages at this commit, for timeline health indicators without fetching CommitDetail.\n",
            "properties": {
              "packageCount": {
                "type": "integer",
                "minimum": 0
              },
              "sourceFiles": {
                "type": "integer",
                "minimum": 0
              },
              "sourceLines": {
                "type": "integer",
                "minimum": 0
              },
              "testFiles": {
                "type": "integer",
                "minimum": 0
              },
              "testLines": {
                "type": "integer",
                "minimum": 0
              },
              "exportCount": {
                "type": "integer",
                "minimum": 0
              },
              "testCaseCount": {
                "type": "integer",
                "minimum": 0
              },
              "issueCountsByKind": {
                "$ref": "#/components/schemas/issue-counts-by-kind"
              },
              "debtCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Sum of all issue kinds (dead-code + oversized-file + package-layout).\n"
              },
              "hasIssueStats": {
                "type": "boolean",
                "description": "True when package_issue_stats were computed for this commit (including a zero-debt sentinel). False for commits scanned before issue stats.\n"
              }
            },
            "required": [
              "packageCount",
              "sourceFiles",
              "sourceLines",
              "testFiles",
              "testLines",
              "exportCount",
              "testCaseCount",
              "issueCountsByKind",
              "debtCount",
              "hasIssueStats"
            ]
          }
        },
        "required": [
          "hash",
          "parentHashes",
          "authoredAt",
          "message",
          "refs",
          "analyzerVersion",
          "computedAt",
          "status",
          "summaryMetrics"
        ]
      },
      "commit-ref": {
        "type": "object",
        "description": "A branch or tag pointer observed at scan time for a commit.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Ref name without the `refs/heads/` or `refs/tags/` prefix.",
            "example": "main"
          },
          "type": {
            "type": "string",
            "enum": [
              "branch",
              "tag"
            ],
            "description": "Whether this ref is a branch or a tag."
          },
          "isMainAncestor": {
            "type": "boolean",
            "description": "True when this commit is an ancestor of the configured main branch (including main itself). Used to distinguish mainline history from feature-branch tips.\n"
          }
        },
        "required": [
          "name",
          "type",
          "isMainAncestor"
        ]
      },
      "issue-counts-by-kind": {
        "type": "object",
        "description": "Per-kind issue counts for a commit or package (all kinds count as debt).",
        "properties": {
          "dead-code": {
            "type": "integer",
            "minimum": 0
          },
          "oversized-file": {
            "type": "integer",
            "minimum": 0
          },
          "package-layout": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "dead-code",
          "oversized-file",
          "package-layout"
        ]
      }
    }
  }
}