{
  "openapi": "3.1.0",
  "info": {
    "title": "getCheckout",
    "version": "1.0.0"
  },
  "paths": {
    "/api/checkout": {
      "get": {
        "summary": "Current checkout (HEAD) analysis status",
        "operationId": "getCheckout",
        "tags": [
          "no-auth"
        ],
        "description": "Resolve git HEAD and report whether that commit has been analyzed, plus package metrics when it has. Also reports local branch compare candidates and the fork-point (merge-base) of HEAD vs `compareRef` (default `main`). Used by the Current checkout UI.\n",
        "parameters": [
          {
            "name": "compareRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Local branch name to take the merge-base against. Defaults to the server `main` ref.\n"
          }
        ],
        "responses": {
          "200": {
            "description": "Checkout status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "hash",
                    "message",
                    "authoredAt",
                    "analyzed",
                    "productRoot",
                    "branch",
                    "packages",
                    "compareCandidates"
                  ],
                  "properties": {
                    "hash": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "authoredAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "analyzed": {
                      "type": "boolean"
                    },
                    "productRoot": {
                      "type": "string",
                      "description": "Analysis path prefix within the repo (e.g. `products`). Empty string means the whole repository. Package `directory` values are relative to this prefix; prepend it for repo-absolute paths.\n"
                    },
                    "branch": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Short branch name for HEAD, or null when detached."
                    },
                    "packages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/package-metrics"
                      }
                    },
                    "compareCandidates": {
                      "type": "array",
                      "description": "Local branch names that can be used as `compareRef` (current branch omitted; configured main ref always included when it exists).\n",
                      "items": {
                        "type": "string"
                      }
                    },
                    "githubRepo": {
                      "type": "string",
                      "description": "GitHub `owner/name` for source and commit links. Omitted when the server has no `DEV_SITE_GITHUB_REPO` configured.\n"
                    },
                    "compare": {
                      "$ref": "#/components/schemas/checkout-compare"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "compareRef is not a valid git object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Git command failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "package-metrics": {
        "type": "object",
        "description": "Per-package file/LOC inventory at a single commit.",
        "properties": {
          "packageName": {
            "type": "string",
            "description": "npm package name (e.g. `@saflib/git`).",
            "example": "@saflib/git"
          },
          "directory": {
            "type": "string",
            "description": "Package directory relative to the analyzed product root.",
            "example": "saflib/git"
          },
          "kind": {
            "type": "string",
            "description": "Package layer kind. From package.json saf.kind when set, otherwise inferred from a unique identifier dependency such as @saflib/drizzle (db), @saflib/express (http), @saflib/openapi (spec), @saflib/sdk (sdk), or @saflib/vue (spa).\n",
            "enum": [
              "db",
              "http",
              "spec",
              "spa",
              "sdk",
              "lib",
              "integration",
              "other"
            ]
          },
          "sourceFiles": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of source files (excluding tests)."
          },
          "sourceLines": {
            "type": "integer",
            "minimum": 0,
            "description": "Total lines across source files."
          },
          "prodLines": {
            "type": "integer",
            "minimum": 0,
            "description": "Production (non-test) source lines."
          },
          "testLines": {
            "type": "integer",
            "minimum": 0,
            "description": "Test file lines."
          },
          "testFiles": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of test files."
          },
          "issueCountsByKind": {
            "$ref": "#/components/schemas/issue-counts-by-kind"
          },
          "debtCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Sum of all issue kinds (dead-code + oversized-file + package-layout).\n"
          }
        },
        "required": [
          "packageName",
          "directory",
          "sourceFiles",
          "sourceLines",
          "prodLines",
          "testLines",
          "testFiles",
          "issueCountsByKind",
          "debtCount"
        ]
      },
      "issue-counts-by-kind": {
        "type": "object",
        "description": "Per-kind issue counts for a commit or package (all kinds count as debt).",
        "properties": {
          "dead-code": {
            "type": "integer",
            "minimum": 0
          },
          "oversized-file": {
            "type": "integer",
            "minimum": 0
          },
          "package-layout": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "dead-code",
          "oversized-file",
          "package-layout"
        ]
      },
      "checkout-compare": {
        "type": "object",
        "description": "Fork-point (merge-base of HEAD and a chosen branch) for Checkout compare mode.\n",
        "required": [
          "againstRef",
          "mergeBaseHash",
          "mergeBaseAnalyzed",
          "mergeBaseMessage",
          "mergeBaseAuthoredAt",
          "renames"
        ],
        "properties": {
          "againstRef": {
            "type": "string",
            "description": "Branch/ref HEAD was compared against (e.g. `main`)."
          },
          "mergeBaseHash": {
            "type": "string",
            "description": "Full hash of `git merge-base(HEAD, againstRef)`."
          },
          "mergeBaseAnalyzed": {
            "type": "boolean",
            "description": "True when that fork-point commit has an analysis snapshot."
          },
          "mergeBaseMessage": {
            "type": "string",
            "description": "Subject of the fork-point commit."
          },
          "mergeBaseAuthoredAt": {
            "type": "string",
            "format": "date-time",
            "description": "Author date of the fork-point commit."
          },
          "renames": {
            "type": "array",
            "description": "File rename pairs from the fork point to HEAD (`git diff --find-renames`). Used by Checkout compare to show moved modules instead of remove+add.\n",
            "items": {
              "type": "object",
              "required": [
                "fromPath",
                "toPath"
              ],
              "properties": {
                "fromPath": {
                  "type": "string",
                  "description": "Path at the fork-point commit."
                },
                "toPath": {
                  "type": "string",
                  "description": "Path at HEAD."
                },
                "score": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Git rename similarity (0-100)."
                }
              }
            }
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}