{
  "openapi": "3.0.0",
  "info": {
    "title": "getCheckout",
    "version": "1.0.0"
  },
  "paths": {
    "/api/checkout": {
      "get": {
        "summary": "Current checkout (HEAD) analysis status",
        "operationId": "getCheckout",
        "tags": [
          "no-auth"
        ],
        "description": "Resolve git HEAD and report whether that commit has been analyzed, plus package metrics when it has. Used by the Current checkout UI.\n",
        "responses": {
          "200": {
            "description": "Checkout status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "hash",
                    "message",
                    "authoredAt",
                    "analyzed",
                    "productRoot",
                    "branch",
                    "packages"
                  ],
                  "properties": {
                    "hash": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "authoredAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "analyzed": {
                      "type": "boolean"
                    },
                    "productRoot": {
                      "type": "string",
                      "description": "Analysis path prefix within the repo (e.g. `products`). Empty string means the whole repository. Package `directory` values are relative to this prefix; prepend it for repo-absolute paths.\n"
                    },
                    "branch": {
                      "type": "string",
                      "nullable": true,
                      "description": "Short branch name for HEAD, or null when detached."
                    },
                    "packages": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/package-metrics"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Git command failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "package-metrics": {
        "type": "object",
        "description": "Per-package file/LOC inventory at a single commit.",
        "properties": {
          "packageName": {
            "type": "string",
            "description": "npm package name (e.g. `@saflib/git`).",
            "example": "@saflib/git"
          },
          "directory": {
            "type": "string",
            "description": "Package directory relative to the analyzed product root.",
            "example": "saflib/git"
          },
          "sourceFiles": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of source files (excluding tests)."
          },
          "sourceLines": {
            "type": "integer",
            "minimum": 0,
            "description": "Total lines across source files."
          },
          "prodLines": {
            "type": "integer",
            "minimum": 0,
            "description": "Production (non-test) source lines."
          },
          "testLines": {
            "type": "integer",
            "minimum": 0,
            "description": "Test file lines."
          },
          "testFiles": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of test files."
          },
          "issueCountsByKind": {
            "$ref": "#/components/schemas/issue-counts-by-kind"
          },
          "debtCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Sum of debt kinds only (dead-code + oversized-file + package-layout).\n"
          }
        },
        "required": [
          "packageName",
          "directory",
          "sourceFiles",
          "sourceLines",
          "prodLines",
          "testLines",
          "testFiles",
          "issueCountsByKind",
          "debtCount"
        ]
      },
      "issue-counts-by-kind": {
        "type": "object",
        "description": "Per-kind issue counts for a commit or package (all kinds count as debt).",
        "properties": {
          "dead-code": {
            "type": "integer",
            "minimum": 0
          },
          "oversized-file": {
            "type": "integer",
            "minimum": 0
          },
          "package-layout": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "dead-code",
          "oversized-file",
          "package-layout"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}