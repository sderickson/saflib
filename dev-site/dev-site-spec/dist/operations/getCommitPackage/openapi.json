{
  "openapi": "3.1.0",
  "info": {
    "title": "getCommitPackage",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commits/{hash}/packages/{package_name}": {
      "get": {
        "summary": "Package-scoped symbols for one analyzed commit",
        "operationId": "getCommitPackage",
        "tags": [
          "no-auth"
        ],
        "description": "Returns metrics, exports, and test cases for a single package at a commit. Prefer this over full commit detail for the checkout Spec panel — assembly only touches that package's source blobs. For db packages, also includes db_inventory (drizzle tables + query dirs). For spec packages, also includes spec_inventory (OpenAPI schemas + REST resources). For http and sdk packages, spec_inventory is joined from a spec package this package depends on, while exports/tests remain this package's own source modules. For spa packages, spec_inventory is joined through SDK request imports so Spec can show loader routes on a component bundle. layout_issues are live working-tree layout/LoC findings for the package directory (cheap; package-local). Full dead-code workdir scans stay on saf-dev-site issues --workdir — not on this Spec package load.\n",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "package_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "npm package name (URL-encoded), e.g. `%40example%2Fbilling-http`"
          }
        ],
        "responses": {
          "200": {
            "description": "Package detail at commit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "package_detail"
                  ],
                  "properties": {
                    "package_detail": {
                      "type": "object",
                      "required": [
                        "commit_hash",
                        "package_name",
                        "directory",
                        "source_files",
                        "source_lines",
                        "prod_lines",
                        "test_lines",
                        "test_files",
                        "exports",
                        "test_cases"
                      ],
                      "properties": {
                        "commit_hash": {
                          "type": "string"
                        },
                        "package_name": {
                          "type": "string"
                        },
                        "directory": {
                          "type": "string"
                        },
                        "source_files": {
                          "type": "integer"
                        },
                        "source_lines": {
                          "type": "integer"
                        },
                        "prod_lines": {
                          "type": "integer"
                        },
                        "test_lines": {
                          "type": "integer"
                        },
                        "test_files": {
                          "type": "integer"
                        },
                        "exports": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/export-entry"
                          }
                        },
                        "test_cases": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/test-case"
                          }
                        },
                        "db_inventory": {
                          "$ref": "#/components/schemas/db-inventory"
                        },
                        "spec_inventory": {
                          "$ref": "#/components/schemas/spec-inventory"
                        },
                        "layout_issues": {
                          "type": "array",
                          "description": "Working-tree package-layout and oversized-file findings (package-local; cheap). Dead-code workdir scans are CLI-only.\n",
                          "items": {
                            "$ref": "#/components/schemas/package-issue"
                          }
                        },
                        "public_export_file_paths": {
                          "type": "array",
                          "description": "Repo-relative files from live package.json `exports` (SPA main.ts, test-app.ts). Spec Issues skips these for dead-code so the panel matches `saf-dev-site issues --workdir`.\n",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Commit or package not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Git command failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "export-entry": {
        "type": "object",
        "description": "One exported symbol extracted from a source file at a commit.",
        "properties": {
          "package_name": {
            "type": "string",
            "description": "npm package that owns this file.",
            "example": "@saflib/git"
          },
          "file_path": {
            "type": "string",
            "description": "Path relative to the repo root.",
            "example": "saflib/git/log.ts"
          },
          "name": {
            "type": "string",
            "description": "Exported symbol name.",
            "example": "log"
          },
          "kind": {
            "type": "string",
            "description": "Declaration kind (mirrors `@saflib/parser`'s ExportKind).",
            "enum": [
              "function",
              "class",
              "interface",
              "type",
              "const",
              "enum",
              "variable",
              "component",
              "prop",
              "emit",
              "model"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ],
            "description": "Syntactic display signature from the AST (no type-checker). Null for re-exports without a local declaration.\n",
            "example": "(repo_root: string, options?: LogOptions)"
          },
          "docstring": {
            "type": [
              "string",
              "null"
            ],
            "description": "First prose line of the leading JSDoc on the export declaration. Null when absent or for bare re-exports (`export { a }`).\n",
            "example": "Walk commits newest-first without checking out."
          },
          "used_by": {
            "type": "array",
            "description": "Non-test product files that import this export (named import match, or whole-module import when names are `*` / default / empty).\n",
            "items": {
              "type": "object",
              "required": [
                "package_name",
                "file_path",
                "repo_path"
              ],
              "properties": {
                "package_name": {
                  "type": "string"
                },
                "file_path": {
                  "type": "string",
                  "description": "Path within the importing package (no package-root prefix)."
                },
                "repo_path": {
                  "type": "string",
                  "description": "Repo-relative path for source links."
                }
              }
            }
          }
        },
        "required": [
          "package_name",
          "file_path",
          "name",
          "kind",
          "signature",
          "docstring"
        ]
      },
      "test-case": {
        "type": "object",
        "description": "One `describe`/`it`/`test` case extracted from a test file. `full_name` uses the `\" > \"` separator from `@saflib/parser` (e.g. `\"outer > inner > does the thing\"`). Optional `subject*` fields soft-link to an exported symbol by convention (suite title matching an adjacent or same-package export).\n",
        "properties": {
          "package_name": {
            "type": "string",
            "description": "npm package that owns this file.",
            "example": "@saflib/git"
          },
          "file_path": {
            "type": "string",
            "description": "Path relative to the repo root.",
            "example": "saflib/git/index.test.ts"
          },
          "full_name": {
            "type": "string",
            "description": "Nested describe/it titles joined with `\" > \"`.",
            "example": "log > returns commits newest-first (git log order)"
          },
          "subject_name": {
            "type": "string",
            "description": "Linked export name when a suite title matches by convention.",
            "example": "log"
          },
          "subject_signature": {
            "type": [
              "string",
              "null"
            ],
            "description": "Signature of the linked export at this commit (null if unknown).",
            "example": "(repo_root: string, options?: LogOptions)"
          },
          "subject_docstring": {
            "type": [
              "string",
              "null"
            ],
            "description": "First JSDoc prose line of the linked export, when present."
          },
          "subject_file_path": {
            "type": "string",
            "description": "Repo-relative path of the file that declares the linked export.",
            "example": "saflib/git/log.ts"
          },
          "subject_confidence": {
            "type": "string",
            "description": "How the link was made (`adjacent` file vs elsewhere in package).",
            "enum": [
              "adjacent",
              "package"
            ]
          }
        },
        "required": [
          "package_name",
          "file_path",
          "full_name"
        ]
      },
      "db-inventory": {
        "type": "object",
        "description": "Drizzle table inventory for one db package (schemas + query dirs).",
        "required": [
          "entities"
        ],
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity",
                "used_by_packages",
                "queries"
              ],
              "properties": {
                "entity": {
                  "type": "string",
                  "description": "Query directory name or kebab form of table name (e.g. package-metrics)."
                },
                "table": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "export_name",
                    "table_name",
                    "columns",
                    "file_path"
                  ],
                  "properties": {
                    "export_name": {
                      "type": "string"
                    },
                    "table_name": {
                      "type": "string"
                    },
                    "file_path": {
                      "type": "string"
                    },
                    "docstring": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "First prose line of leading JSDoc on the table const."
                    },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "prop_name",
                          "sql_name",
                          "type_kind"
                        ],
                        "properties": {
                          "prop_name": {
                            "type": "string"
                          },
                          "sql_name": {
                            "type": "string"
                          },
                          "type_kind": {
                            "type": "string"
                          },
                          "docstring": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "First prose line of leading JSDoc on the column."
                          }
                        }
                      }
                    }
                  }
                },
                "used_by_packages": {
                  "type": "array",
                  "description": "Distinct packages (non-test) that import any query under this entity.",
                  "items": {
                    "type": "string"
                  }
                },
                "queries": {
                  "type": "array",
                  "description": "Leaf query modules under queries/<entity>/ (excluding index and tests).",
                  "items": {
                    "type": "object",
                    "required": [
                      "file_name",
                      "file_path",
                      "used_by"
                    ],
                    "properties": {
                      "file_name": {
                        "type": "string"
                      },
                      "file_path": {
                        "type": "string"
                      },
                      "export_name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "signature": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "docstring": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "used_by": {
                        "type": "array",
                        "description": "Non-test product files that import this leaf query module.",
                        "items": {
                          "type": "object",
                          "required": [
                            "package_name",
                            "file_path",
                            "repo_path"
                          ],
                          "properties": {
                            "package_name": {
                              "type": "string"
                            },
                            "file_path": {
                              "type": "string",
                              "description": "Path within the importing package (no package-root prefix)."
                            },
                            "repo_path": {
                              "type": "string",
                              "description": "Repo-relative path for source links."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "spec-inventory": {
        "type": "object",
        "description": "OpenAPI inventory for one spec package — business objects (schemas/) and/or REST resources (routes/), linked by normalized name stems. Operations include links to HTTP handlers and SDK requests from packages that depend on this spec. Also attached to http package detail for the HTTP Spec pane.\n",
        "required": [
          "entities"
        ],
        "properties": {
          "package_directory": {
            "type": "string",
            "description": "Repo-relative directory of the spec package this inventory was built from (used for route YAML source links when shown from an http pane).\n"
          },
          "entities": {
            "type": "array",
            "description": "Flat alphabetical list of object / both / routes entities.",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "presence",
                "used_by_packages",
                "operations"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Stable entity key (e.g. both:Matter, routes:admin, object:Error)."
                },
                "label": {
                  "type": "string",
                  "description": "Display name — schema component name when present, else resource folder."
                },
                "presence": {
                  "type": "string",
                  "enum": [
                    "object",
                    "routes",
                    "both"
                  ],
                  "description": "object = schema only; routes = REST resource only; both = schema + matching resource.\n"
                },
                "resource": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "routes/<resource> folder name when present."
                },
                "schema": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "name",
                    "yaml_path",
                    "properties",
                    "used_by",
                    "referenced_by_operations"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "components/schemas name (e.g. Matter)."
                    },
                    "yaml_path": {
                      "type": "string",
                      "description": "Package-relative path to the schema YAML."
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "properties": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "type_kind"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "type_kind": {
                            "type": "string"
                          },
                          "docstring": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "used_by": {
                      "type": "array",
                      "description": "Non-test product files importing schemas/<Name>.",
                      "items": {
                        "$ref": "#/components/schemas/items"
                      }
                    },
                    "referenced_by_operations": {
                      "type": "array",
                      "description": "operation_ids whose request/2xx response $ref this schema.",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "used_by_packages": {
                  "type": "array",
                  "description": "Distinct packages importing this entity's schema and/or the SDK request modules for its operations.\n",
                  "items": {
                    "type": "string"
                  }
                },
                "operations": {
                  "type": "array",
                  "description": "REST operations under the linked resource (empty for object-only).",
                  "items": {
                    "type": "object",
                    "required": [
                      "operation_id",
                      "method",
                      "path",
                      "tags",
                      "yaml_path",
                      "request_schemas",
                      "response_schemas",
                      "handler_tests",
                      "used_by"
                    ],
                    "properties": {
                      "operation_id": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "summary": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "tags": {
                        "type": "array",
                        "description": "OpenAPI operation tags.",
                        "items": {
                          "type": "string"
                        }
                      },
                      "yaml_path": {
                        "type": "string",
                        "description": "Package-relative route YAML under the spec package."
                      },
                      "route_stem": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "Isomorphic stem after routes/handlers/requests (e.g. matters/core/create).\n"
                      },
                      "handler": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "Sibling HTTP handler file when present.",
                        "required": [
                          "file_path",
                          "repo_path"
                        ],
                        "properties": {
                          "file_path": {
                            "type": "string"
                          },
                          "repo_path": {
                            "type": "string"
                          }
                        }
                      },
                      "request": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "Sibling SDK request module when present.",
                        "required": [
                          "file_path",
                          "repo_path"
                        ],
                        "properties": {
                          "file_path": {
                            "type": "string"
                          },
                          "repo_path": {
                            "type": "string"
                          }
                        }
                      },
                      "fake": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "description": "Sibling SDK fake/MSW module (`*.fake.ts`) when present beside the request.\n",
                        "required": [
                          "file_path",
                          "repo_path"
                        ],
                        "properties": {
                          "file_path": {
                            "type": "string"
                          },
                          "repo_path": {
                            "type": "string"
                          }
                        }
                      },
                      "handler_tests": {
                        "type": "array",
                        "description": "describe/it/test specifications extracted from colocated HTTP handler test files (full_name uses \" > \" nesting).\n",
                        "items": {
                          "type": "object",
                          "required": [
                            "full_name"
                          ],
                          "properties": {
                            "full_name": {
                              "type": "string",
                              "description": "Nested describe/it titles joined with \" > \".",
                              "example": "createMatter > creates a matter for the org"
                            }
                          }
                        }
                      },
                      "request_schemas": {
                        "type": "array",
                        "description": "Business objects in the request body (one layer deep into object/array bags of schema refs).\n",
                        "items": {
                          "type": "string"
                        }
                      },
                      "response_schemas": {
                        "type": "array",
                        "description": "Business objects in 2xx responses (one layer deep into object/array bags of schema refs).\n",
                        "items": {
                          "type": "string"
                        }
                      },
                      "used_by": {
                        "type": "array",
                        "description": "Non-test product files importing the sibling SDK request module for this route stem.\n",
                        "items": {
                          "type": "object",
                          "required": [
                            "package_name",
                            "file_path",
                            "repo_path"
                          ],
                          "properties": {
                            "package_name": {
                              "type": "string"
                            },
                            "file_path": {
                              "type": "string",
                              "description": "Path within the importing package (no package-root prefix)."
                            },
                            "repo_path": {
                              "type": "string",
                              "description": "Repo-relative path for source links."
                            }
                          }
                        }
                      },
                      "enqueues": {
                        "type": "array",
                        "description": "operation_ids this op may enqueue (product job trigger map). Present only when the HTTP app was configured with a map.\n",
                        "items": {
                          "type": "string"
                        }
                      },
                      "enqueued_by": {
                        "type": "array",
                        "description": "operation_ids or `cron:…` keys that may enqueue this op. Present only when the HTTP app was configured with a map.\n",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "items": {
        "type": "object",
        "required": [
          "package_name",
          "file_path",
          "repo_path"
        ],
        "properties": {
          "package_name": {
            "type": "string"
          },
          "file_path": {
            "type": "string",
            "description": "Path within the importing package (no package-root prefix)."
          },
          "repo_path": {
            "type": "string",
            "description": "Repo-relative path for source links."
          }
        }
      },
      "package-issue": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "name",
          "kind_label",
          "file_path",
          "repo_path"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "dead-code",
              "oversized-file",
              "package-layout"
            ]
          },
          "title": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind_label": {
            "type": "string"
          },
          "file_path": {
            "type": "string",
            "description": "Package-local path for display"
          },
          "repo_path": {
            "type": "string",
            "description": "Repo-relative path for open-source links"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}