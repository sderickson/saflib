{
  "openapi": "3.0.0",
  "info": {
    "title": "getCommitPackage",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commits/{hash}/packages/{packageName}": {
      "get": {
        "summary": "Package-scoped symbols for one analyzed commit",
        "operationId": "getCommitPackage",
        "tags": [
          "no-auth"
        ],
        "description": "Returns metrics, exports, and test cases for a single package at a commit. Prefer this over full commit detail for the checkout Spec panel — assembly only touches that package's source blobs. For db packages, also includes `dbInventory` (drizzle tables + query dirs). For `-spec` packages, also includes `specInventory` (OpenAPI schemas + REST resources). For `-http` packages, `specInventory` is the sibling `-spec` triangle join (route cards) while exports/tests remain the HTTP or SDK package's own source modules. `layoutIssues` are live working-tree layout/LoC findings for the package directory (cheap; package-local). Full dead-code workdir scans stay on `saf-dev-site issues --workdir` — not on this Spec package load.\n",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "packageName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "npm package name (URL-encoded), e.g. `%40example%2Fbilling-http`"
          }
        ],
        "responses": {
          "200": {
            "description": "Package detail at commit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "packageDetail"
                  ],
                  "properties": {
                    "packageDetail": {
                      "type": "object",
                      "required": [
                        "commitHash",
                        "packageName",
                        "directory",
                        "sourceFiles",
                        "sourceLines",
                        "prodLines",
                        "testLines",
                        "testFiles",
                        "exports",
                        "testCases"
                      ],
                      "properties": {
                        "commitHash": {
                          "type": "string"
                        },
                        "packageName": {
                          "type": "string"
                        },
                        "directory": {
                          "type": "string"
                        },
                        "sourceFiles": {
                          "type": "integer"
                        },
                        "sourceLines": {
                          "type": "integer"
                        },
                        "prodLines": {
                          "type": "integer"
                        },
                        "testLines": {
                          "type": "integer"
                        },
                        "testFiles": {
                          "type": "integer"
                        },
                        "exports": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/export-entry"
                          }
                        },
                        "testCases": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/test-case"
                          }
                        },
                        "dbInventory": {
                          "$ref": "#/components/schemas/db-inventory"
                        },
                        "specInventory": {
                          "$ref": "#/components/schemas/spec-inventory"
                        },
                        "layoutIssues": {
                          "type": "array",
                          "description": "Working-tree package-layout and oversized-file findings (package-local; cheap). Dead-code workdir scans are CLI-only.\n",
                          "items": {
                            "$ref": "#/components/schemas/package-issue"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Commit or package not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Git command failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "export-entry": {
        "type": "object",
        "description": "One exported symbol extracted from a source file at a commit.",
        "properties": {
          "packageName": {
            "type": "string",
            "description": "npm package that owns this file.",
            "example": "@saflib/git"
          },
          "filePath": {
            "type": "string",
            "description": "Path relative to the repo root.",
            "example": "saflib/git/log.ts"
          },
          "name": {
            "type": "string",
            "description": "Exported symbol name.",
            "example": "log"
          },
          "kind": {
            "type": "string",
            "description": "Declaration kind (mirrors `@saflib/parser`'s ExportKind).",
            "enum": [
              "function",
              "class",
              "interface",
              "type",
              "const",
              "enum",
              "variable"
            ]
          },
          "signature": {
            "type": "string",
            "nullable": true,
            "description": "Syntactic display signature from the AST (no type-checker). Null for re-exports without a local declaration.\n",
            "example": "(repoRoot: string, options?: LogOptions)"
          },
          "docstring": {
            "type": "string",
            "nullable": true,
            "description": "First prose line of the leading JSDoc on the export declaration. Null when absent or for bare re-exports (`export { a }`).\n",
            "example": "Walk commits newest-first without checking out."
          },
          "usedBy": {
            "type": "array",
            "description": "Non-test product files that import this export (named import match, or whole-module import when names are `*` / default / empty).\n",
            "items": {
              "type": "object",
              "required": [
                "packageName",
                "filePath",
                "repoPath"
              ],
              "properties": {
                "packageName": {
                  "type": "string"
                },
                "filePath": {
                  "type": "string",
                  "description": "Path within the importing package (no package-root prefix)."
                },
                "repoPath": {
                  "type": "string",
                  "description": "Repo-relative path for source links."
                }
              }
            }
          }
        },
        "required": [
          "packageName",
          "filePath",
          "name",
          "kind",
          "signature",
          "docstring"
        ]
      },
      "test-case": {
        "type": "object",
        "description": "One `describe`/`it`/`test` case extracted from a test file. `fullName` uses the `\" > \"` separator from `@saflib/parser` (e.g. `\"outer > inner > does the thing\"`). Optional `subject*` fields soft-link to an exported symbol by convention (suite title matching an adjacent or same-package export).\n",
        "properties": {
          "packageName": {
            "type": "string",
            "description": "npm package that owns this file.",
            "example": "@saflib/git"
          },
          "filePath": {
            "type": "string",
            "description": "Path relative to the repo root.",
            "example": "saflib/git/index.test.ts"
          },
          "fullName": {
            "type": "string",
            "description": "Nested describe/it titles joined with `\" > \"`.",
            "example": "log > returns commits newest-first (git log order)"
          },
          "subjectName": {
            "type": "string",
            "description": "Linked export name when a suite title matches by convention.",
            "example": "log"
          },
          "subjectSignature": {
            "type": "string",
            "nullable": true,
            "description": "Signature of the linked export at this commit (null if unknown).",
            "example": "(repoRoot: string, options?: LogOptions)"
          },
          "subjectDocstring": {
            "type": "string",
            "nullable": true,
            "description": "First JSDoc prose line of the linked export, when present."
          },
          "subjectFilePath": {
            "type": "string",
            "description": "Repo-relative path of the file that declares the linked export.",
            "example": "saflib/git/log.ts"
          },
          "subjectConfidence": {
            "type": "string",
            "description": "How the link was made (`adjacent` file vs elsewhere in package).",
            "enum": [
              "adjacent",
              "package"
            ]
          }
        },
        "required": [
          "packageName",
          "filePath",
          "fullName"
        ]
      },
      "db-inventory": {
        "type": "object",
        "description": "Drizzle table inventory for one db package (schemas + query dirs).",
        "required": [
          "entities"
        ],
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity",
                "usedByPackages",
                "queries"
              ],
              "properties": {
                "entity": {
                  "type": "string",
                  "description": "Query directory name or kebab form of table name (e.g. package-metrics)."
                },
                "table": {
                  "type": "object",
                  "nullable": true,
                  "required": [
                    "exportName",
                    "tableName",
                    "columns",
                    "filePath"
                  ],
                  "properties": {
                    "exportName": {
                      "type": "string"
                    },
                    "tableName": {
                      "type": "string"
                    },
                    "filePath": {
                      "type": "string"
                    },
                    "docstring": {
                      "type": "string",
                      "nullable": true,
                      "description": "First prose line of leading JSDoc on the table const."
                    },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "propName",
                          "sqlName",
                          "typeKind"
                        ],
                        "properties": {
                          "propName": {
                            "type": "string"
                          },
                          "sqlName": {
                            "type": "string"
                          },
                          "typeKind": {
                            "type": "string"
                          },
                          "docstring": {
                            "type": "string",
                            "nullable": true,
                            "description": "First prose line of leading JSDoc on the column."
                          }
                        }
                      }
                    }
                  }
                },
                "usedByPackages": {
                  "type": "array",
                  "description": "Distinct packages (non-test) that import any query under this entity.",
                  "items": {
                    "type": "string"
                  }
                },
                "queries": {
                  "type": "array",
                  "description": "Leaf query modules under queries/<entity>/ (excluding index and tests).",
                  "items": {
                    "type": "object",
                    "required": [
                      "fileName",
                      "filePath",
                      "usedBy"
                    ],
                    "properties": {
                      "fileName": {
                        "type": "string"
                      },
                      "filePath": {
                        "type": "string"
                      },
                      "exportName": {
                        "type": "string",
                        "nullable": true
                      },
                      "signature": {
                        "type": "string",
                        "nullable": true
                      },
                      "docstring": {
                        "type": "string",
                        "nullable": true
                      },
                      "usedBy": {
                        "type": "array",
                        "description": "Non-test product files that import this leaf query module.",
                        "items": {
                          "type": "object",
                          "required": [
                            "packageName",
                            "filePath",
                            "repoPath"
                          ],
                          "properties": {
                            "packageName": {
                              "type": "string"
                            },
                            "filePath": {
                              "type": "string",
                              "description": "Path within the importing package (no package-root prefix)."
                            },
                            "repoPath": {
                              "type": "string",
                              "description": "Repo-relative path for source links."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "spec-inventory": {
        "type": "object",
        "description": "OpenAPI inventory for one `-spec` package — business objects (schemas/) and/or REST resources (routes/), linked by normalized name stems. Operations include triangle links to sibling `-http` handlers and `-sdk` requests when present. Also attached to `-http` package detail (sibling join) for the HTTP Spec pane.\n",
        "required": [
          "entities"
        ],
        "properties": {
          "packageDirectory": {
            "type": "string",
            "description": "Repo-relative directory of the `-spec` package this inventory was built from (used for route YAML source links when shown from an `-http` pane).\n"
          },
          "entities": {
            "type": "array",
            "description": "Flat alphabetical list of object / both / routes entities.",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "presence",
                "usedByPackages",
                "operations"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Stable entity key (e.g. both:Matter, routes:admin, object:Error)."
                },
                "label": {
                  "type": "string",
                  "description": "Display name — schema component name when present, else resource folder."
                },
                "presence": {
                  "type": "string",
                  "enum": [
                    "object",
                    "routes",
                    "both"
                  ],
                  "description": "object = schema only; routes = REST resource only; both = schema + matching resource.\n"
                },
                "resource": {
                  "type": "string",
                  "nullable": true,
                  "description": "routes/<resource> folder name when present."
                },
                "schema": {
                  "type": "object",
                  "nullable": true,
                  "required": [
                    "name",
                    "yamlPath",
                    "properties",
                    "usedBy",
                    "referencedByOperations"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "components/schemas name (e.g. Matter)."
                    },
                    "yamlPath": {
                      "type": "string",
                      "description": "Package-relative path to the schema YAML."
                    },
                    "description": {
                      "type": "string",
                      "nullable": true
                    },
                    "properties": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "typeKind"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "typeKind": {
                            "type": "string"
                          },
                          "docstring": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    },
                    "usedBy": {
                      "type": "array",
                      "description": "Non-test product files importing schemas/<Name>.",
                      "items": {
                        "$ref": "#/components/schemas/items"
                      }
                    },
                    "referencedByOperations": {
                      "type": "array",
                      "description": "operationIds whose request/2xx response $ref this schema.",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "usedByPackages": {
                  "type": "array",
                  "description": "Distinct packages importing this entity's schema and/or the SDK request modules for its operations.\n",
                  "items": {
                    "type": "string"
                  }
                },
                "operations": {
                  "type": "array",
                  "description": "REST operations under the linked resource (empty for object-only).",
                  "items": {
                    "type": "object",
                    "required": [
                      "operationId",
                      "method",
                      "path",
                      "tags",
                      "yamlPath",
                      "requestSchemas",
                      "responseSchemas",
                      "handlerTests",
                      "usedBy"
                    ],
                    "properties": {
                      "operationId": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string",
                        "nullable": true
                      },
                      "tags": {
                        "type": "array",
                        "description": "OpenAPI operation tags.",
                        "items": {
                          "type": "string"
                        }
                      },
                      "yamlPath": {
                        "type": "string",
                        "description": "Package-relative route YAML under the spec package."
                      },
                      "routeStem": {
                        "type": "string",
                        "nullable": true,
                        "description": "Isomorphic stem after routes/handlers/requests (e.g. matters/core/create).\n"
                      },
                      "handler": {
                        "type": "object",
                        "nullable": true,
                        "description": "Sibling HTTP handler file when present.",
                        "required": [
                          "filePath",
                          "repoPath"
                        ],
                        "properties": {
                          "filePath": {
                            "type": "string"
                          },
                          "repoPath": {
                            "type": "string"
                          }
                        }
                      },
                      "request": {
                        "type": "object",
                        "nullable": true,
                        "description": "Sibling SDK request module when present.",
                        "required": [
                          "filePath",
                          "repoPath"
                        ],
                        "properties": {
                          "filePath": {
                            "type": "string"
                          },
                          "repoPath": {
                            "type": "string"
                          }
                        }
                      },
                      "fake": {
                        "type": "object",
                        "nullable": true,
                        "description": "Sibling SDK fake/MSW module (`*.fake.ts`) when present beside the request.\n",
                        "required": [
                          "filePath",
                          "repoPath"
                        ],
                        "properties": {
                          "filePath": {
                            "type": "string"
                          },
                          "repoPath": {
                            "type": "string"
                          }
                        }
                      },
                      "handlerTests": {
                        "type": "array",
                        "description": "describe/it/test specifications extracted from colocated HTTP handler test files (fullName uses \" > \" nesting).\n",
                        "items": {
                          "type": "object",
                          "required": [
                            "fullName"
                          ],
                          "properties": {
                            "fullName": {
                              "type": "string",
                              "description": "Nested describe/it titles joined with \" > \".",
                              "example": "createMatter > creates a matter for the org"
                            }
                          }
                        }
                      },
                      "requestSchemas": {
                        "type": "array",
                        "description": "Business objects in the request body (one layer deep into object/array bags of schema refs).\n",
                        "items": {
                          "type": "string"
                        }
                      },
                      "responseSchemas": {
                        "type": "array",
                        "description": "Business objects in 2xx responses (one layer deep into object/array bags of schema refs).\n",
                        "items": {
                          "type": "string"
                        }
                      },
                      "usedBy": {
                        "type": "array",
                        "description": "Non-test product files importing the sibling SDK request module for this route stem.\n",
                        "items": {
                          "type": "object",
                          "required": [
                            "packageName",
                            "filePath",
                            "repoPath"
                          ],
                          "properties": {
                            "packageName": {
                              "type": "string"
                            },
                            "filePath": {
                              "type": "string",
                              "description": "Path within the importing package (no package-root prefix)."
                            },
                            "repoPath": {
                              "type": "string",
                              "description": "Repo-relative path for source links."
                            }
                          }
                        }
                      },
                      "enqueues": {
                        "type": "array",
                        "description": "operationIds this op may enqueue (product job trigger map). Present only when the HTTP app was configured with a map.\n",
                        "items": {
                          "type": "string"
                        }
                      },
                      "enqueuedBy": {
                        "type": "array",
                        "description": "operationIds or `cron:…` keys that may enqueue this op. Present only when the HTTP app was configured with a map.\n",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "items": {
        "type": "object",
        "required": [
          "packageName",
          "filePath",
          "repoPath"
        ],
        "properties": {
          "packageName": {
            "type": "string"
          },
          "filePath": {
            "type": "string",
            "description": "Path within the importing package (no package-root prefix)."
          },
          "repoPath": {
            "type": "string",
            "description": "Repo-relative path for source links."
          }
        }
      },
      "package-issue": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "name",
          "kindLabel",
          "filePath",
          "repoPath"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "dead-code",
              "oversized-file",
              "package-layout"
            ]
          },
          "title": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kindLabel": {
            "type": "string"
          },
          "filePath": {
            "type": "string",
            "description": "Package-local path for display"
          },
          "repoPath": {
            "type": "string",
            "description": "Repo-relative path for open-source links"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}