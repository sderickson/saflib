{
  "openapi": "3.1.0",
  "info": {
    "title": "getCommits",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commits/{hash}": {
      "get": {
        "summary": "Get the full analysis snapshot for a commit",
        "operationId": "getCommits",
        "tags": [
          "no-auth"
        ],
        "description": "Returns commit metadata plus per-package metrics, exports, and test cases for a single analyzed commit.\n",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Full 40-char commit object hash."
          }
        ],
        "responses": {
          "200": {
            "description": "Full commit analysis snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "commit_detail"
                  ],
                  "properties": {
                    "commit_detail": {
                      "$ref": "#/components/schemas/commit-detail"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No analysis snapshot found for this commit hash.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "commit-detail": {
        "type": "object",
        "description": "Full static-analysis snapshot for one commit — metadata plus per-package metrics, exports, and test cases.\n",
        "properties": {
          "commit": {
            "$ref": "#/components/schemas/commit"
          },
          "package_metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/package-metrics"
            }
          },
          "exports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/export-entry"
            }
          },
          "test_cases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/test-case"
            }
          }
        },
        "required": [
          "commit",
          "package_metrics",
          "exports",
          "test_cases"
        ]
      },
      "commit": {
        "type": "object",
        "description": "Analyzed commit metadata — one row per scanned commit. Does not include per-package / export / test-case payloads (see CommitDetail for those).\n",
        "properties": {
          "hash": {
            "type": "string",
            "description": "Full 40-char commit object hash.",
            "example": "a1b2c3d4e5f6789012345678901234567890abcd"
          },
          "parent_hashes": {
            "type": "array",
            "description": "Parent commit hashes (empty for the root commit).",
            "items": {
              "type": "string"
            }
          },
          "authored_at": {
            "type": "string",
            "format": "date-time",
            "description": "Author date from the commit (`%aI`).",
            "example": "2026-08-12T10:00:00-07:00"
          },
          "message": {
            "type": "string",
            "description": "Full commit message (subject + body).",
            "example": "Add inventory for package metrics"
          },
          "refs": {
            "type": "array",
            "description": "Branch/tag pointers that currently resolve to this commit.",
            "items": {
              "$ref": "#/components/schemas/commit-ref"
            }
          },
          "analyzer_version": {
            "type": "string",
            "description": "Version string of the analyzer that produced this snapshot.",
            "example": "1"
          },
          "computed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this snapshot was written to the database.",
            "example": "2026-08-12T11:00:00-07:00"
          },
          "status": {
            "type": "string",
            "description": "Analysis status for this commit.",
            "enum": [
              "pending",
              "complete",
              "failed"
            ],
            "example": "complete"
          }
        },
        "required": [
          "hash",
          "parent_hashes",
          "authored_at",
          "message",
          "refs",
          "analyzer_version",
          "computed_at",
          "status"
        ]
      },
      "commit-ref": {
        "type": "object",
        "description": "A branch or tag pointer observed at scan time for a commit.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Ref name without the `refs/heads/` or `refs/tags/` prefix.",
            "example": "main"
          },
          "type": {
            "type": "string",
            "enum": [
              "branch",
              "tag"
            ],
            "description": "Whether this ref is a branch or a tag."
          },
          "is_main_ancestor": {
            "type": "boolean",
            "description": "True when this commit is an ancestor of the configured main branch (including main itself). Used to distinguish mainline history from feature-branch tips.\n"
          }
        },
        "required": [
          "name",
          "type",
          "is_main_ancestor"
        ]
      },
      "package-metrics": {
        "type": "object",
        "description": "Per-package file/LOC inventory at a single commit.",
        "properties": {
          "package_name": {
            "type": "string",
            "description": "npm package name (e.g. `@saflib/git`).",
            "example": "@saflib/git"
          },
          "directory": {
            "type": "string",
            "description": "Package directory relative to the analyzed product root.",
            "example": "saflib/git"
          },
          "kind": {
            "type": "string",
            "description": "Package layer kind. From package.json saf.kind when set, otherwise inferred from a unique identifier dependency such as @saflib/drizzle (db), @saflib/express (http), @saflib/openapi (spec), @saflib/sdk (sdk), or @saflib/vue (spa).\n",
            "enum": [
              "db",
              "http",
              "spec",
              "spa",
              "sdk",
              "lib",
              "integration",
              "other"
            ]
          },
          "source_files": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of source files (excluding tests)."
          },
          "source_lines": {
            "type": "integer",
            "minimum": 0,
            "description": "Total lines across source files."
          },
          "prod_lines": {
            "type": "integer",
            "minimum": 0,
            "description": "Production (non-test) source lines."
          },
          "test_lines": {
            "type": "integer",
            "minimum": 0,
            "description": "Test file lines."
          },
          "test_files": {
            "type": "integer",
            "minimum": 0,
            "description": "Count of test files."
          },
          "issue_counts_by_kind": {
            "$ref": "#/components/schemas/issue-counts-by-kind"
          },
          "debt_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Sum of all issue kinds (dead-code + oversized-file + package-layout).\n"
          }
        },
        "required": [
          "package_name",
          "directory",
          "source_files",
          "source_lines",
          "prod_lines",
          "test_lines",
          "test_files",
          "issue_counts_by_kind",
          "debt_count"
        ]
      },
      "issue-counts-by-kind": {
        "type": "object",
        "description": "Per-kind issue counts for a commit or package (all kinds count as debt).",
        "properties": {
          "dead-code": {
            "type": "integer",
            "minimum": 0
          },
          "oversized-file": {
            "type": "integer",
            "minimum": 0
          },
          "package-layout": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "dead-code",
          "oversized-file",
          "package-layout"
        ]
      },
      "export-entry": {
        "type": "object",
        "description": "One exported symbol extracted from a source file at a commit.",
        "properties": {
          "package_name": {
            "type": "string",
            "description": "npm package that owns this file.",
            "example": "@saflib/git"
          },
          "file_path": {
            "type": "string",
            "description": "Path relative to the repo root.",
            "example": "saflib/git/log.ts"
          },
          "name": {
            "type": "string",
            "description": "Exported symbol name.",
            "example": "log"
          },
          "kind": {
            "type": "string",
            "description": "Declaration kind (mirrors `@saflib/parser`'s ExportKind).",
            "enum": [
              "function",
              "class",
              "interface",
              "type",
              "const",
              "enum",
              "variable",
              "component",
              "prop",
              "emit",
              "model"
            ]
          },
          "signature": {
            "type": [
              "string",
              "null"
            ],
            "description": "Syntactic display signature from the AST (no type-checker). Null for re-exports without a local declaration.\n",
            "example": "(repo_root: string, options?: LogOptions)"
          },
          "docstring": {
            "type": [
              "string",
              "null"
            ],
            "description": "First prose line of the leading JSDoc on the export declaration. Null when absent or for bare re-exports (`export { a }`).\n",
            "example": "Walk commits newest-first without checking out."
          },
          "used_by": {
            "type": "array",
            "description": "Non-test product files that import this export (named import match, or whole-module import when names are `*` / default / empty).\n",
            "items": {
              "type": "object",
              "required": [
                "package_name",
                "file_path",
                "repo_path"
              ],
              "properties": {
                "package_name": {
                  "type": "string"
                },
                "file_path": {
                  "type": "string",
                  "description": "Path within the importing package (no package-root prefix)."
                },
                "repo_path": {
                  "type": "string",
                  "description": "Repo-relative path for source links."
                }
              }
            }
          }
        },
        "required": [
          "package_name",
          "file_path",
          "name",
          "kind",
          "signature",
          "docstring"
        ]
      },
      "test-case": {
        "type": "object",
        "description": "One `describe`/`it`/`test` case extracted from a test file. `full_name` uses the `\" > \"` separator from `@saflib/parser` (e.g. `\"outer > inner > does the thing\"`). Optional `subject*` fields soft-link to an exported symbol by convention (suite title matching an adjacent or same-package export).\n",
        "properties": {
          "package_name": {
            "type": "string",
            "description": "npm package that owns this file.",
            "example": "@saflib/git"
          },
          "file_path": {
            "type": "string",
            "description": "Path relative to the repo root.",
            "example": "saflib/git/index.test.ts"
          },
          "full_name": {
            "type": "string",
            "description": "Nested describe/it titles joined with `\" > \"`.",
            "example": "log > returns commits newest-first (git log order)"
          },
          "subject_name": {
            "type": "string",
            "description": "Linked export name when a suite title matches by convention.",
            "example": "log"
          },
          "subject_signature": {
            "type": [
              "string",
              "null"
            ],
            "description": "Signature of the linked export at this commit (null if unknown).",
            "example": "(repo_root: string, options?: LogOptions)"
          },
          "subject_docstring": {
            "type": [
              "string",
              "null"
            ],
            "description": "First JSDoc prose line of the linked export, when present."
          },
          "subject_file_path": {
            "type": "string",
            "description": "Repo-relative path of the file that declares the linked export.",
            "example": "saflib/git/log.ts"
          },
          "subject_confidence": {
            "type": "string",
            "description": "How the link was made (`adjacent` file vs elsewhere in package).",
            "enum": [
              "adjacent",
              "package"
            ]
          }
        },
        "required": [
          "package_name",
          "file_path",
          "full_name"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}