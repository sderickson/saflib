{
  "name": "@saflib/jobs-db",
  "description": "Database package for jobs.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./instances": "./instances.ts",
    "./errors": "./errors.ts",
    "./types": "./types.ts",
    "./queries/*": "./queries/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/drizzle": "*",
    "drizzle-orm": "^0.45.2",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
