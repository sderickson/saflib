{
  "name": "@saflib/jobs-spec",
  "description": "API specs for the jobs service",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./openapi.yaml": "./openapi.yaml",
    "./operations/*": "./dist/operations/*/index.ts",
    "./schemas/*": "./dist/schemas/*/index.ts",
    "./schemas/job.yaml": "./schemas/job.yaml"
  },
  "scripts": {
    "build": "saf-specs generate -f openapi.yaml -o dist",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/openapi": "*"
  },
  "sideEffects": false
}
