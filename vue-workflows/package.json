{
  "name": "@saflib/vue-workflows",
  "saf": {
    "kind": "lib"
  },
  "description": "New-engine (sqlite-backed) workflows for scaffolding @saflib/vue SPAs, static sites, views, and e2e tests.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./add-view": "./add-view.ts",
    "./add-spa": "./add-spa.ts",
    "./add-static-site": "./add-static-site.ts",
    "./add-e2e-test": "./add-e2e-test.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/new-workflows": "*",
    "@saflib/new-workflows-db": "*",
    "@saflib/templates": "*",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/dev-tools": "*",
    "@saflib/vitest": "*",
    "@saflib/monorepo": "*"
  },
  "sideEffects": false
}
