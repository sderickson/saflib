{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "template-package/workflows": [
        "./workflows/templates/template-package-workflows.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../templates"
    },
    {
      "path": "../utils"
    }
  ]
}
