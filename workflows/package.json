{
  "name": "@saflib/workflows",
  "saf": {
    "kind": "lib"
  },
  "description": "Workflow engine and utilities for SAF",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./workflows": "./workflows/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "pack": "rm -rf dist/src && rm -f dist/saflib-workflows-*.tgz && npm run build && cp -r docs dist/src && cp -r workflows dist/src && cp ./docs/01-overview.md dist/README.md && cd dist && npm pack"
  },
  "dependencies": {
    "@saflib/templates": "*",
    "commander": "^15.0.0",
    "minimatch": "^10.1.1",
    "xstate": "^5.19.3",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0"
  },
  "sideEffects": false
}
