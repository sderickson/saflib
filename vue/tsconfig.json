{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../analytics/analytics-sdk"
    },
    {
      "path": "../analytics/analytics-spec"
    },
    {
      "path": "../links"
    },
    {
      "path": "../monorepo"
    },
    {
      "path": "../sdk"
    },
    {
      "path": "../templates"
    },
    {
      "path": "../utils"
    }
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results"
  ]
}
