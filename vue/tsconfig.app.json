{
  "extends": "./tsconfig.app.base.json",
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "vite/client"
    ]
  },
  "references": [
    {
      "path": "../links"
    },
    {
      "path": "../monorepo"
    },
    {
      "path": "../sdk"
    },
    {
      "path": "../utils"
    }
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/**/*.test.ts",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ]
}
