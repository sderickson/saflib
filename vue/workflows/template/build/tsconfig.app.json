{
  // Has the vue config supercede the project's base tsconfig
  "extends": ["@saflib/monorepo/tsconfig.json", "@vue/tsconfig"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./dist/types"
  },
  "exclude": ["node_modules", "vite.config.ts", "dist"]
}
