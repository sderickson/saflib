{
  "extends": [
    "@saflib/vue/tsconfig.app.json"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./dist/types"
  },
  "include": [
    ".vitepress/theme/**/*.ts",
    ".vitepress/theme/**/*.vue",
    "assets.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist/types"
  ],
  "references": [
    {
      "path": "../../.."
    },
    {
      "path": "../../../../links"
    },
    {
      "path": "../common"
    },
    {
      "path": "../links"
    }
  ]
}
