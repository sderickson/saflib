{
  "name": "@saflib/email-spec",
  "description": "Testing endpoint for email sends",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./operations/*": "./dist/operations/*/index.ts",
    "./schemas/*": "./dist/schemas/*/index.ts"
  },
  "dependencies": {
    "@saflib/openapi": "*"
  },
  "devDependencies": {
    "openapi-types": "*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "saf-specs generate -f openapi.yaml -o dist",
    "typecheck": "tsc -b",
    "generate": "npm exec saf-specs generate"
  },
  "sideEffects": false
}
