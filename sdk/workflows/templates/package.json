{
  "name": "template-package-sdk",
  "description": "Tanstack queries and shared components for __service-name__ service",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./client.ts",
    "./fakes": "./fakes.ts",
    "./i18n": "./i18n.ts",
    "./strings": "./strings.ts",
    "./test-app": "./test-app.ts",
    "./typed-fake": "./typed-fake.ts",
    "./requests/*": "./requests/*/index.ts",
    "./requests/*/*": "./requests/*/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b",
    "dev": "NODE_OPTIONS='--experimental-strip-types --disable-warning=ExperimentalWarning' vite",
    "dev-docker": "npm exec saf-docker generate && docker compose up --build"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@testing-library/vue": "^8.1.0"
  },
  "dependencies": {
    "@saflib/monorepo": "*",
    "@saflib/sdk": "*",
    "template-package-spec": "*",
    "@saflib/vite": "*",
    "@saflib/vue": "*",
    "@saflib/ory-kratos-sdk": "*",
    "msw": "^2.11.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "sideEffects": [
    "./client.ts"
  ]
}
