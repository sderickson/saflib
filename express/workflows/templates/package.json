{
  "name": "template-package-http",
  "saf": {
    "kind": "http"
  },
  "description": "HTTP server for the __service-name__ service",
  "type": "module",
  "exports": {
    "./http": "./http.ts",
    "./testing/slim-route-test": "./testing/slim-route-test.ts",
    "./handlers/*": "./handlers/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/express": "*",
    "@saflib/monorepo": "*",
    "template-package-db": "*",
    "template-package-service-common": "*",
    "template-package-spec": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
