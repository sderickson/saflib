{
  "extends": "@saflib/monorepo/tsconfig.json",
  "exclude": [
    "./workflows/query-template/**",
    "workflows/handler-template/**",
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "references": [
    {
      "path": "../env"
    },
    {
      "path": "../analytics/analytics-http"
    },
    {
      "path": "../errors/errors-http"
    },
    {
      "path": "../node"
    },
    {
      "path": "../node-log/node-log-http"
    },
    {
      "path": "../notify/notify"
    },
    {
      "path": "../openapi"
    },
    {
      "path": "../templates"
    },
    {
      "path": "../utils"
    }
  ],
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": [
    "**/*.ts",
    "**/*.json"
  ]
}
