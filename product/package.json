{
  "name": "@saflib/product",
  "saf": {
    "kind": "lib"
  },
  "description": "Package for product workflows",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./workflows": "./workflows/index.ts"
  },
  "bin": {
    "saf-create": "./bin/saf-create/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/monorepo": "*",
    "@saflib/templates": "*",
    "@saflib/utils": "*",
    "@saflib/workflows": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
