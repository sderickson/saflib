{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../../../../../../drizzle/workflows/templates"
    },
    {
      "path": "../../../../../../env"
    },
    {
      "path": "../../../../../../express/workflows/templates"
    },
    {
      "path": "../../../../../../monorepo"
    },
    {
      "path": "../../../../../../sentry"
    },
    {
      "path": "../../../../../../service/workflows/common-templates"
    },
    {
      "path": "../kratos-handlers"
    }
  ]
}
