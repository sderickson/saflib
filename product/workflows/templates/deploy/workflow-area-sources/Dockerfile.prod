# Source for CopyStep upsert into deploy/Dockerfile.prod.
# Live Dockerfile.prod keeps static areas empty; product/init areas must match validate.
# BEGIN WORKFLOW AREA build-static-sites FOR vue/add-static-site
FROM __organization-name__-__product-name__-__static-subdomain-name__-static:latest AS __static-subdomain-name__-static-builder
RUN npm run build
# END WORKFLOW AREA

# BEGIN WORKFLOW AREA build-product-dependencies FOR product/init
# END WORKFLOW AREA

# BEGIN WORKFLOW AREA copy-static-sites FOR vue/add-static-site
COPY --from=__static-subdomain-name__-static-builder /app/__product-name__/clients/__static-subdomain-name__/.vitepress/dist /srv/__product-name__-__static-subdomain-name__
# END WORKFLOW AREA

# BEGIN WORKFLOW AREA copy-product-assets FOR product/init
# END WORKFLOW AREA
