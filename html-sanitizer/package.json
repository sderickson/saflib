{
  "name": "@saflib/html-sanitizer",
  "saf": {
    "kind": "lib"
  },
  "description": "Allowlist HTML sanitizer that rebuilds its output, with no DOM (works on the server and in the browser)",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@types/jsdom": "^30.0.0",
    "dompurify": "^3.4.17",
    "jsdom": "^31.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "entities": "^7.0.1",
    "htmlparser2": "^12.0.0"
  }
}
