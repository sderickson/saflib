{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "types": [
      "node"
    ],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../commander"
    },
    {
      "path": "../cron/cron"
    },
    {
      "path": "../drizzle"
    },
    {
      "path": "../email/email-service"
    },
    {
      "path": "../env"
    },
    {
      "path": "../express"
    },
    {
      "path": "../grpc/grpc"
    },
    {
      "path": "../integrations"
    },
    {
      "path": "../monorepo"
    },
    {
      "path": "../openapi"
    },
    {
      "path": "../processes"
    },
    {
      "path": "../product"
    },
    {
      "path": "../sdk"
    },
    {
      "path": "../service"
    },
    {
      "path": "../vendors/sentry"
    },
    {
      "path": "../vue"
    },
    {
      "path": "../workflows"
    },
    {
      "path": "../xstate"
    }
  ]
}
