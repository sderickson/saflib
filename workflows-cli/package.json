{
  "name": "@saflib/workflows-cli",
  "saf": {
    "kind": "lib"
  },
  "description": "Project-specific workflows using @saflib/workflows",
  "private": true,
  "type": "module",
  "bin": {
    "saf-workflow": "./workflow-cli.ts"
  },
  "dependencies": {
    "@saflib/commander": "*",
    "@saflib/cron": "*",
    "@saflib/drizzle": "*",
    "@saflib/email-service": "*",
    "@saflib/env": "*",
    "@saflib/express": "*",
    "@saflib/grpc": "*",
    "@saflib/integrations": "*",
    "@saflib/monorepo": "*",
    "@saflib/openapi": "*",
    "@saflib/processes": "*",
    "@saflib/product": "*",
    "@saflib/sentry": "*",
    "@saflib/sdk": "*",
    "@saflib/service": "*",
    "@saflib/vue": "*",
    "@saflib/workflows": "*",
    "@saflib/xstate": "*"
  },
  "scripts": {
    "typecheck": "tsc --incremental -p tsconfig.typecheck.json",
    "live-test": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./live-test.ts"
  },
  "sideEffects": false
}
