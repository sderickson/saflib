{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    {
      "path": "../commander"
    },
    {
      "path": "../imports"
    }
  ],
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": [
      "node"
    ],
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "include": [
    "**/*.ts"
  ]
}
