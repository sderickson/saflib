{
  "name": "@saflib/git",
  "saf": {
    "kind": "lib"
  },
  "description": "Thin git plumbing wrappers (log / ls-tree / cat-file) — no checkout required",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/monorepo": "*",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
