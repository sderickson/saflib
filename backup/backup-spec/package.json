{
  "name": "@saflib/backup-spec",
  "description": "API specs for the backup service",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./operations/*": "./dist/operations/*/index.ts",
    "./schemas/*": "./dist/schemas/*/index.ts"
  },
  "scripts": {
    "build": "saf-specs generate -f openapi.yaml -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "generate": "npm exec saf-specs generate"
  },
  "dependencies": {
    "@saflib/openapi": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
