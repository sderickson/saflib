{
  "openapi": "3.1.0",
  "info": {
    "title": "listBackups",
    "version": "1.0.0"
  },
  "paths": {
    "/backups": {
      "get": {
        "summary": "List all backups",
        "operationId": "listBackups",
        "security": [
          {
            "session": [
              "site-admin"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "List of backups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/backup"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - user does not have required privileges.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "backup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The backup ID parsed from the filename",
            "example": "backup-20240101-120000"
          },
          "type": {
            "type": "string",
            "enum": [
              "manual",
              "automatic"
            ],
            "description": "The type of backup, parsed from the filename",
            "example": "automatic"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp parsed from the filename",
            "example": "2024-01-01T12:00:00Z"
          },
          "size": {
            "type": "number",
            "description": "File size in bytes",
            "example": 1048576,
            "minimum": 0
          },
          "path": {
            "type": "string",
            "description": "Full path to the backup file in object store",
            "example": "backups/automatic/backup-20240101-120000.sql"
          },
          "metadata": {
            "type": "object",
            "description": "Optional metadata fields for the backup",
            "additionalProperties": true,
            "properties": {
              "source": {
                "type": "string",
                "description": "Source of the backup",
                "example": "database"
              },
              "version": {
                "type": "string",
                "description": "Version of the backup format",
                "example": "1.0"
              }
            }
          }
        },
        "required": [
          "id",
          "type",
          "timestamp",
          "size",
          "path"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ory_kratos_session",
        "description": "Signed-in SAF user (Kratos browser session; internal job calls present the same identity via a signed assertion, which is not modeled here). Scopes: `email-verified`, `mfa`, `site-admin` (implies email-verified + mfa).\n"
      }
    }
  }
}