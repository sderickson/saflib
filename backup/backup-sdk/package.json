{
  "name": "@saflib/backup-sdk",
  "saf": {
    "kind": "sdk"
  },
  "description": "Tanstack queries and shared components for backup service",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./fakes": "./fakes.ts",
    "./strings": "./strings.ts",
    "./components": "./components.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@testing-library/vue": "^8.1.0"
  },
  "dependencies": {
    "@saflib/monorepo": "*",
    "@saflib/sdk": "*",
    "@saflib/backup-spec": "*",
    "@saflib/vue": "*",
    "msw": "^2.11.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "sideEffects": [
    "./../../../client.ts"
  ]
}
