{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    {
      "path": "../../env"
    },
    {
      "path": "../../secret-store"
    }
  ],
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "include": [
    "**/*.ts",
    "**/*.json"
  ]
}
