{
  "name": "@saflib/vendors-infisical",
  "saf": {
    "kind": "lib",
    "envExtends": ["@saflib/env"]
  },
  "description": "Infisical-backed SecretStore adapter and process-level configure helpers",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./env": "./env.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.0",
    "@saflib/env": "*",
    "@saflib/secret-store": "*"
  },
  "devDependencies": {
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
