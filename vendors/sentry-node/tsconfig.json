{
  "extends": "@saflib/monorepo/tsconfig.json",
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "outDir": "./dist/types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "references": [
    {
      "path": "../../env"
    },
    {
      "path": "../../errors/errors-service"
    },
    {
      "path": "../../node"
    },
    {
      "path": "../../utils"
    }
  ]
}
