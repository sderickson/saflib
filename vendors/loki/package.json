    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/env": "*",
    "@saflib/node": "*",
    "winston": "^3.0.0",
    "winston-loki": "^6.1.3"
  },
  "devDependencies": {
    "@saflib/monorepo": "*",
    "@saflib/vitest": "*"
  },
  "sideEffects": false
