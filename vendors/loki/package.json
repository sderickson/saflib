{
  "name": "@saflib/vendors-loki",
  "saf": {
    "kind": "lib"
  },
  "description": "Winston Loki transport helper for sending logs to a Loki instance",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./env": "./env.ts"
  },
  "scripts": {
