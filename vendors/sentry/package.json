{
  "name": "@saflib/vendors-sentry",
  "saf": {
    "kind": "lib",
    "envExtends": ["@saflib/env"]
  },
  "description": "Sentry adapters: Node/Vue init, Vite source-map upload, and env schema",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./createSentryCallback": "./createSentryCallback.ts",
    "./env": "./env.ts",
    "./vite-build": "./vite-build.ts",
    "./workflows": "./workflows/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@saflib/env": "*",
    "@saflib/errors-http": "*",
    "@saflib/errors-sdk": "*",
    "@saflib/errors-spec": "*",
    "@saflib/errors-vue": "*",
    "@saflib/node": "*",
    "@sentry/node": "^10.0.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@sentry/vue": "^10.0.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*",
    "@saflib/workflows": "*",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "vue": "*"
  },
  "sideEffects": false
}
